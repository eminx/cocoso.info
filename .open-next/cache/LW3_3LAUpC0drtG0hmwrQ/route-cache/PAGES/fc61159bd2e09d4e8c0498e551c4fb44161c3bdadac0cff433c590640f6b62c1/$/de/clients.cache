{"type":"page","meta":{"routeCache":{"key":"/route-cache/PAGES/fc61159bd2e09d4e8c0498e551c4fb44161c3bdadac0cff433c590640f6b62c1/$/de/clients","owner":{"kind":"PAGES","sourceRoute":"/clients"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"de\"><head><meta charSet=\"utf-8\" data-next-head=\"\"/><meta name=\"viewport\" content=\"width=device-width\" data-next-head=\"\"/><title data-next-head=\"\"></title><meta name=\"description\" content=\"Open-Source-Software für Föderationen von Gemeinschaften, Genossenschaften und Basisgruppen — Kalender, Ressourcen, Veranstaltungen, Gruppen, frei gestaltbare Seiten und mehr, immer zu Ihren eigenen Bedingungen.\" data-next-head=\"\"/><link rel=\"preload\" href=\"/_next/static/css/544d7195a2962901.css\" as=\"style\"/><link rel=\"stylesheet\" href=\"/_next/static/css/544d7195a2962901.css\" data-n-g=\"\"/><noscript data-n-css=\"\"></noscript><script defer=\"\" noModule=\"\" src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\"></script><script src=\"/_next/static/chunks/webpack-ccef31ea74e09183.js\" defer=\"\"></script><script src=\"/_next/static/chunks/framework-11aa62c2873f4bd5.js\" defer=\"\"></script><script src=\"/_next/static/chunks/main-daf286fdb6421785.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/_app-4744dc754b095ee4.js\" defer=\"\"></script><script src=\"/_next/static/chunks/994-a0e9857083a5d631.js\" defer=\"\"></script><script src=\"/_next/static/chunks/226-c328413f0b133673.js\" defer=\"\"></script><script src=\"/_next/static/chunks/324-f5d3748c16c44ee3.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/clients-d4d29b0b4ed41763.js\" defer=\"\"></script><script src=\"/_next/static/LW3_3LAUpC0drtG0hmwrQ/_buildManifest.js\" defer=\"\"></script><script src=\"/_next/static/LW3_3LAUpC0drtG0hmwrQ/_ssgManifest.js\" defer=\"\"></script><style id=\"__jsx-8df70e60372d0001\">@import url(\"https://fonts.googleapis.com/css2?family=Sarabun:wght@500;800&family=Inknut+Antiqua:wght@700&display=swap\");</style><style data-styled=\"\" data-styled-version=\"5.3.11\">.bSBCpk{font-size:18px;line-height:1.375;text-align:center;}/*!sc*/\ndata-styled.g9[id=\"StyledText-sc-1sadyjn-0\"]{content:\"bSBCpk,\"}/*!sc*/\n.dgwdhB{box-sizing:border-box;display:-webkit-inline-box;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;font-size:inherit;line-height:inherit;color:#FF6F59;font-weight:700;-webkit-text-decoration:none;text-decoration:none;cursor:pointer;}/*!sc*/\n.dgwdhB:hover{-webkit-text-decoration:underline;text-decoration:underline;}/*!sc*/\ndata-styled.g19[id=\"StyledAnchor-sc-1rp7lwl-0\"]{content:\"dgwdhB,\"}/*!sc*/\n.gvavzw{font-family:'Sarabun',sans-serif;font-size:16px;line-height:24px;background-color:hsla(88,62%,90%,0.1);color:#444444;box-sizing:border-box;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;-moz-osx-font-smoothing:grayscale;-webkit-font-smoothing:antialiased;}/*!sc*/\ndata-styled.g145[id=\"StyledGrommet-sc-19lkkz7-0\"]{content:\"gvavzw,\"}/*!sc*/\n</style></head><body><link rel=\"preload\" as=\"image\" href=\"/cocoso-logo-small.png\"/><link rel=\"preload\" as=\"image\" href=\"/partners/samarbetet-logo.webp\"/><link rel=\"preload\" as=\"image\" href=\"/partners/kkv-logo.webp\"/><link rel=\"preload\" as=\"image\" href=\"/slider/hojdenlogo.webp\"/><link rel=\"preload\" as=\"image\" href=\"/partners/gerlesborg-logo.webp\"/><link rel=\"preload\" as=\"image\" href=\"/slider/mina-logo-beyaz.png\"/><link rel=\"preload\" as=\"image\" href=\"/credits/skogen.png\"/><link rel=\"preload\" as=\"image\" href=\"/credits/CCA.svg\"/><link rel=\"preload\" as=\"image\" href=\"/credits/ge.png\"/><link rel=\"preload\" as=\"image\" href=\"/credits/circles.svg\"/><link rel=\"preload\" as=\"image\" href=\"/credits/lilo.png\"/><div id=\"__next\"><div class=\"StyledGrommet-sc-19lkkz7-0 gvavzw\"><nav class=\"top-nav--desktop\"><a class=\"top-nav-logo\" href=\"/de\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"top-nav-links\"><a href=\"/de\"><span class=\"top-nav-link\">Start</span></a><a href=\"/de/features\"><span class=\"top-nav-link\">Funktionen</span></a><a href=\"/de/clients\"><span class=\"top-nav-link nav-item-active\">Beispiele</span></a><a href=\"/de/contact\"><span class=\"top-nav-link\">Kontakt</span></a></div><a class=\"btn-demo\" href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Live-Demo</a><div class=\"nav-dropdown\"><button type=\"button\" class=\"lang-trigger\">Deutsch<svg width=\"10\" height=\"7\" viewBox=\"0 0 10 7\" fill=\"none\"><path d=\"M1 1L5 5.5L9 1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></div></nav><nav class=\"top-nav-mobile-bar\"><a class=\"top-nav-logo\" href=\"/de\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"nav-dropdown\"><button type=\"button\" class=\"burger-trigger\" aria-label=\"Menu\"><svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" fill=\"none\"><path d=\"M0 1H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 8H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 15H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path></svg></button></div></nav><div class=\"features-header-band\"><div class=\"features-header-blobs\"></div><div class=\"features-header-inner\"><h1 class=\"hero-title\" style=\"font-size:clamp(24px, 4vw, 34px)\">Anwendungsbeispiele</h1><p class=\"hero-lead\">Echte Gemeinschaften, Studios und Künstler:innen, die bereits mit Cocoso arbeiten — föderierte Netzwerke, gemeinsame Arbeitsräume, Veranstaltungskalender und persönliche Portfolios, jeweils passend zugeschnitten.</p></div></div><div class=\"quick-nav reveal-fade\"><a class=\"quick-nav-chip\" href=\"#Samarbetet\" style=\"background:#FFE3DD;--chip-accent:#FF6F59\">Samarbetet</a><a class=\"quick-nav-chip\" href=\"#KKV Stockholm\" style=\"background:#FFF1D6;--chip-accent:#FFB84C\">KKV Stockholm</a><a class=\"quick-nav-chip\" href=\"#höjden\" style=\"background:#DFF3E7;--chip-accent:#3FA772\">höjden</a><a class=\"quick-nav-chip\" href=\"#Gerlesborgs Kulturhus\" style=\"background:#DDEFFF;--chip-accent:#3DA9FC\">Gerlesborgs Kulturhus</a><a class=\"quick-nav-chip\" href=\"#Mîna Kocailik\" style=\"background:#EAE3FF;--chip-accent:#8C6FF7\">Mîna Kocailik</a></div><section id=\"Samarbetet\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/processes-mcgill-library-IpZCihceRkQ-unsplash.jpg);--accent:#FF6F59;--accent-soft:#FFE3DD;--accent-deep:#0F3D3E\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#FF6F59\"><div class=\"story-index\" style=\"--accent-transparent:#FF6F59b3\">01</div><h2 class=\"story-title\">Samarbetet</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(90, 70%, 82%, 1)\">Schweden</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Föderation</span><span class=\"tag-chip\" style=\"background:hsla(270, 70%, 82%, 1)\">Künstler &amp; Kulturräume</span></div><div class=\"story-logo-frame\"><img class=\"story-logo\" src=\"/partners/samarbetet-logo.webp\" alt=\"Samarbetet\"/></div><p class=\"story-text\">Samarbetet ist eine Föderation unabhängiger Gemeinschaften in ganz Schweden — Künstler:innen, Kulturräume, Gärten, Werkstätten und Menschen, verbunden in einem gemeinsamen Netzwerk.</p><a class=\"btn-thick story-link\" href=\"https://www.samarbetet.org\" target=\"_blank\" rel=\"noopener noreferrer\">samarbetet.org besuchen</a></div></div></section><section id=\"KKV Stockholm\" class=\"story-section\"><div class=\"story-bg story-bg--top\" style=\"background-image:url(/slider/works-boston-public-library-awhvI865NQk-unsplash.jpg);--accent:#FFB84C;--accent-soft:#FFF1D6;--accent-deep:#1B2A4A\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#FFB84C\"><div class=\"story-index\" style=\"--accent-transparent:#FFB84Cb3\">02</div><h2 class=\"story-title\">KKV Stockholm</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(90, 70%, 82%, 1)\">Ressourcenbuchung</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">200+ Ressourcen</span><span class=\"tag-chip\" style=\"background:hsla(270, 70%, 82%, 1)\">400+ Mitglieder</span></div><div class=\"story-logo-frame\"><img class=\"story-logo\" src=\"/partners/kkv-logo.webp\" alt=\"KKV Stockholm\"/></div><p class=\"story-text\">KKV Stockholm — Konstnärernas Kollektivverkstad — ist eine Gemeinschaftswerkstatt für professionelle Künstler:innen und gibt über 400 Mitgliedern gemeinsamen Zugang zu mehr als 200 Ausrüstungsgegenständen und Werkstattflächen.</p><a class=\"btn-thick story-link\" href=\"https://stockholm.kkv.nu\" target=\"_blank\" rel=\"noopener noreferrer\">stockholm.kkv.nu besuchen</a></div></div></section><section id=\"höjden\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/activities-mcgill-library-1Rbv8ubJix0-unsplash.jpg);--accent:#3FA772;--accent-soft:#DFF3E7;--accent-deep:#3D1220\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#3FA772\"><div class=\"story-index\" style=\"--accent-transparent:#3FA772b3\">03</div><h2 class=\"story-title\">höjden</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(90, 70%, 82%, 1)\">Künstlerisch geführter Raum</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Ressourcenbuchung</span><span class=\"tag-chip\" style=\"background:hsla(270, 70%, 82%, 1)\">Portfolios</span></div><div class=\"story-logo-frame\"><img class=\"story-logo\" src=\"/slider/hojdenlogo.webp\" alt=\"höjden\"/></div><p class=\"story-text\">höjden ist ein künstlerisch geführter Raum in Stockholm — Studios, eine Bühne, eine Tanzfläche, eine Galerie und eine Küche, seit 2018 gemeinschaftlich betrieben von der Genossenschaft Släktet.</p><a class=\"btn-thick story-link\" href=\"https://www.hojden.house/en\" target=\"_blank\" rel=\"noopener noreferrer\">hojden.house besuchen</a></div></div></section><section id=\"Gerlesborgs Kulturhus\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/calendar-birmingham-museums-trust-RpELX3wVm_U-unsplash.jpg);--accent:#3DA9FC;--accent-soft:#DDEFFF;--accent-deep:#4A2A12\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#3DA9FC\"><div class=\"story-index\" style=\"--accent-transparent:#3DA9FCb3\">04</div><h2 class=\"story-title\">Gerlesborgs Kulturhus</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(90, 70%, 82%, 1)\">Kulturzentrum</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Öffentliche Veranstaltungen</span><span class=\"tag-chip\" style=\"background:hsla(270, 70%, 82%, 1)\">Kalender</span></div><div class=\"story-logo-frame\"><img class=\"story-logo\" src=\"/partners/gerlesborg-logo.webp\" alt=\"Gerlesborgs Kulturhus\"/></div><p class=\"story-text\">Gerlesborgs kulturhus ist ein Kulturzentrum in Hamburgsund, Schweden, das Ausstellungen, Konzerte, Workshops und ein Literaturfestival für die umliegende Gemeinschaft veranstaltet.</p><a class=\"btn-thick story-link\" href=\"https://www.gerlesborgskulturhus.se\" target=\"_blank\" rel=\"noopener noreferrer\">gerlesborgskulturhus.se besuchen</a></div></div></section><section id=\"Mîna Kocailik\" class=\"story-section\"><div class=\"story-bg story-bg--top\" style=\"background-image:url(/slider/mina.jpeg);--accent:#8C6FF7;--accent-soft:#EAE3FF;--accent-deep:#2E3B12\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#8C6FF7\"><div class=\"story-index\" style=\"--accent-transparent:#8C6FF7b3\">05</div><h2 class=\"story-title\">Mîna Kocailik</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(120, 70%, 82%, 1)\">Portfolio</span><span class=\"tag-chip\" style=\"background:hsla(240, 70%, 82%, 1)\">Unabhängige Künstlerin</span></div><div class=\"story-logo-frame story-logo-frame--dark\"><img class=\"story-logo\" src=\"/slider/mina-logo-beyaz.png\" alt=\"Mîna Kocailik\"/></div><p class=\"story-text\">Mîna Kocailik ist eine unabhängige Künstlerin, die Cocoso schlicht nutzt, um ihr Portfolio zu veröffentlichen: eine klare, selbstverwaltete Präsentation ihrer Arbeit, ohne zusätzlichen Pflegeaufwand.</p><a class=\"btn-thick story-link\" href=\"https://en.minakocailik.com\" target=\"_blank\" rel=\"noopener noreferrer\">Ihr Portfolio besuchen</a></div></div></section><div class=\"credits-section\"><div class=\"simple-card\"><h2 class=\"simple-title\" style=\"text-align:center\">Credits</h2><div class=\"credits-block reveal-fade\"><span class=\"StyledText-sc-1sadyjn-0 bSBCpk\">Entwickelt in einer fantastischen Zusammenarbeit mit<a target=\"_blank\" href=\"https://www.skogen.pm\" class=\"StyledAnchor-sc-1rp7lwl-0 dgwdhB\"> <!-- -->Skogen</a></span><img width=\"220px\" src=\"/credits/skogen.png\" class=\"StyledImage-sc-ey4zx9-0 jqEYlx\"/></div><div class=\"credits-block reveal-fade\"><span class=\"StyledText-sc-1sadyjn-0 bSBCpk\">Unterstützt von</span><img height=\"100px\" src=\"/credits/CCA.svg\" class=\"StyledImage-sc-ey4zx9-0 jqEYlx\"/><a target=\"_blank\" href=\"https://currency.community\" class=\"StyledAnchor-sc-1rp7lwl-0 dgwdhB\">Community Currency Alliance</a></div><div class=\"credits-block reveal-fade\"><img width=\"160px\" src=\"/credits/ge.png\" class=\"StyledImage-sc-ey4zx9-0 jqEYlx\"/><a target=\"_blank\" href=\"https://www.grassrootseconomics.org\" class=\"StyledAnchor-sc-1rp7lwl-0 dgwdhB\">Grassroots Economics</a></div><div class=\"credits-block reveal-fade\"><img height=\"90px\" src=\"/credits/circles.svg\" class=\"StyledImage-sc-ey4zx9-0 jqEYlx\"/><a target=\"_blank\" href=\"https://joincircles.net\" class=\"StyledAnchor-sc-1rp7lwl-0 dgwdhB\">Circles UBI</a></div><div class=\"credits-block reveal-fade\"><img width=\"190px\" src=\"/credits/lilo.png\" class=\"StyledImage-sc-ey4zx9-0 jqEYlx\"/><a target=\"_blank\" href=\"https://www.laborislove.se\" class=\"StyledAnchor-sc-1rp7lwl-0 dgwdhB\">Labor is Love</a></div></div></div><footer class=\"site-footer\"><div class=\"footer-rainbow\"></div><div class=\"footer-inner\"><div class=\"footer-brand\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/><p>Open-Source-Software für Föderationen von Gemeinschaften, Genossenschaften und Basisgruppen — eine öffentliche Website und ein Intranet, immer zu Ihren eigenen Bedingungen.</p></div><div class=\"footer-col\"><p class=\"footer-col-title\">Entdecken</p><a href=\"/de\">Start</a><a href=\"/de/features\">Funktionen</a><a href=\"/de/clients\">Beispiele</a><a href=\"/de/contact\">Kontakt</a></div><div class=\"footer-col\"><p class=\"footer-col-title\">Projekt</p><a href=\"https://github.com/eminx/cocoso\" target=\"_blank\" rel=\"noopener noreferrer\">Quellcode</a><a href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Live-Demo</a><p class=\"footer-license\">Frei und quelloffen, lizenziert unter der GNU GPLv3.</p></div></div><div class=\"footer-bottom\"><p>© 2026 Cocoso. Gebaut für autonome Gemeinschaften überall.</p></div></footer></div></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"__lang\":\"de\",\"__namespaces\":{\"common\":{\"meta\":{\"title\":\"Cocoso — Software für Gemeinschaftskooperation\",\"description\":\"Open-Source-Software für Föderationen von Gemeinschaften, Genossenschaften und Basisgruppen — Kalender, Ressourcen, Veranstaltungen, Gruppen, frei gestaltbare Seiten und mehr, immer zu Ihren eigenen Bedingungen.\"},\"brand\":{\"title\":\"COCOSO\",\"slogan\":\"Software für Gemeinschaftskooperation\"},\"nav\":{\"home\":\"Start\",\"features\":\"Funktionen\",\"examples\":\"Beispiele\",\"contact\":\"Kontakt\",\"sourceCode\":\"Quellcode\",\"getStarted\":\"Funktionen entdecken\",\"demo\":\"Live-Demo\",\"language\":\"Sprache\"},\"home\":{\"leadTitle\":\"Software für autonome, föderierte Gemeinschaften\",\"lead\":[\"Cocoso ist Open-Source-Software für autonome Gemeinschaften: eine öffentliche Website und ein Intranet, an einem Ort. Gebaut für Genossenschaften, Ökodörfer, künstlerisch geführte Räume, Festivals und Basisgruppen, die ihre eigenen Abläufe zu ihren eigenen Bedingungen führen wollen.\",\"Ein Login. Viele Gemeinschaften. Ihre Daten, immer Ihre eigenen.\"],\"leadTags\":[\"Online-Plattformen\",\"Genossenschaften\",\"Non-Profits\",\"Festivals\",\"Konferenzen\",\"Künstlerisch geführte Räume\",\"Ökodörfer\",\"Gemeinschaften\",\"Zeltplätze\"],\"tripleTitle\":\"Mehr als eine Website\",\"tripleTags\":[\"Öffentliche Website\",\"Gemeinschaftsnetzwerk\",\"Produktivitätstool\"],\"triple\":[\"Cocoso ist eine öffentliche Website, damit die Welt sehen kann, wer Sie sind, was Sie tun und was ansteht — keine separate Seite nötig.\",\"Es ist zugleich ein privates Gemeinschaftsnetzwerk: Mitglieder können Aktivitäten folgen, Updates teilen und miteinander in Verbindung bleiben — ohne Werbung, Algorithmen oder Tracking. Soziale Medien, minus der Ausbeutung.\",\"Und es ist ein echtes Produktivitätswerkzeug für die praktische Seite des Gemeinschaftslebens: ein gemeinsamer Kalender, Ressourcenbuchungen, Anmeldungen und Admin-Werkzeuge, die alle auf demselben Stand halten.\"],\"federationTitle\":\"Föderation\",\"federationTags\":[\"Netzwerk aus Gemeinschaften\",\"Portal\",\"Gemeinsame Auffindbarkeit\",\"Autonom per Default\"],\"federation\":[\"Cocoso ist nicht auf eine einzelne Gruppe beschränkt. Eine einzige Installation kann eine ganze Föderation unabhängiger Gemeinschaften beherbergen — jede mit eigener Domain, eigenem Erscheinungsbild, eigenen Mitgliedern — und trotzdem als Teil eines größeren Netzwerks auffindbar bleiben.\",\"Eine Föderation kann eine Gemeinschaft als ihr Portal bestimmen: eine gemeinsame Eingangstür, über die Besucher jede Mitgliedsgemeinschaft durchstöbern, Aktivitäten netzwerkweit filtern und ihren Weg finden. Jede Gemeinschaft bleibt unabhängig; das Netzwerk bleibt zusammenhängend.\",\"Das passt natürlich zu einer Bewegung aus vielen autonomen Gruppen — etwa einem Netzwerk aus Ökodörfern, Genossenschaften oder Basisinitiativen, die zusammenstehen wollen, ohne ihre lokale Selbstverwaltung aufzugeben.\"],\"accountsTitle\":\"Ein Login, viele Gemeinschaften\",\"accountsTags\":[\"Globale Konten\",\"Rollen pro Gemeinschaft\",\"Portable Identität\",\"Verifizierte Mitgliedschaft\"],\"accounts\":[\"Jede Person hat ein einziges Cocoso-Konto, ganz gleich, wo ihre Gemeinschaften angesiedelt sind. Treten Sie hier einer Genossenschaft bei, dort einem Festival, anderswo einem Ökodorf — eine Identität begleitet Sie, während Rolle und Sichtbarkeit an jedem Ort unabhängig festgelegt werden.\",\"Admins verifizieren Mitglieder gemeinschaftsweise und vergeben so das Recht, Aktivitäten zu veröffentlichen, eine Gruppe zu leiten oder Ressourcen vor Ort zu verwalten — ohne je die Einstellungen oder Mitglieder einer anderen Gemeinschaft anzutasten.\"],\"dataTitle\":\"Ihre Daten gehören Ihnen\",\"dataTags\":[\"Kein Tracking\",\"Keine Drittanbieter\",\"Datensouveränität\",\"Privacy by Design\"],\"data\":[\"Cocoso enthält keine Werkzeuge, um Nutzer auszuspähen oder ihre Daten zu verfolgen. Es werden keine Informationen an Drittanbieter oder Werbetreibende weitergegeben — die Daten gehören der Gemeinschaft, die sie erzeugt hat, Punkt.\",\"Jedes Mitglied entscheidet selbst, wie viel es von seinen eigenen Informationen teilt, und jede Gemeinschaft entscheidet, wie viel ihrer Aktivität sie der weiteren Föderation zeigt. Sie führen Ihre Projekte — und Ihre Daten — zu Ihren eigenen Bedingungen.\"],\"openSourceTitle\":\"Open Source\",\"openSourceTags\":[\"Selbst hostbar\",\"Community-getrieben\",\"Transparent\",\"Frei wie in Freiheit\"],\"openSource\":[\"Cocoso ist freie, quelloffene Software, die offen entwickelt wird — Sie können jede Zeile davon lesen, sie auf Ihrem eigenen Server betreiben oder einem Hoster Ihrer Wahl vertrauen. Kein Vendor-Lock-in, keine Blackbox.\",\"Geprägt wird sie von den Gemeinschaften, die sie nutzen: Künstler:innen, Genossenschaften, alternative Währungsprojekte und Orte des gemeinsamen Schaffens, die seit den frühesten Tagen reale Bedürfnisse in das Projekt zurückspielen.\"],\"ctaTitle\":\"Sehen Sie, was Cocoso alles kann\",\"ctaBody\":\"Vom Kalender bis zum Admin-Panel — jede Funktion ist so gebaut, dass eine Gemeinschaft sie selbst nutzen kann, nicht nur ein Webmaster. Entdecken Sie, was drinsteckt.\",\"ctaButton\":\"Funktionen entdecken\",\"ctaSecondary\":\"Oder sagen Sie einfach Hallo\"},\"features\":{\"pageTitle\":\"Funktionen\",\"pageLead\":\"Cocoso im Detail — jedes Werkzeug, das Ihre Gemeinschaft nutzen kann, und wie es funktioniert.\",\"groupCommunityTitle\":\"Für Ihre Gemeinschaft\",\"groupAdminTitle\":\"Für Admins\",\"activityTitle\":\"Aktivitäten\",\"activityTags\":[\"Öffentliche Veranstaltungen\",\"Anmeldung\",\"Work-in-Progress\",\"Aufführungen\",\"Ausstellungen\",\"Konzerte\",\"Konferenzen\",\"Interne Termine\",\"Buchungen\"],\"activities\":[\"Die früheste Version von Cocoso wurde für ein künstlerisch geführtes Tanztheater und einen gemeinsamen Lernraum gebaut, der mehrere öffentliche Bühnenauftritte für vorab angemeldetes Publikum ausrichtete. Das Verwalten und Veröffentlichen anpassbarer, wiederkehrender Veranstaltungen erfordert mehrere unterschiedliche Funktionen, Anmeldung eingeschlossen. Anmeldungen werden den Gästen per E-Mail bestätigt, und Veranstaltungsadmins können Ankünfte an der Tür verifizieren.\",\"Sie können Inhalte mit Bild, Titel, Beschreibung und weiteren Informationen erstellen, bearbeiten und löschen, dazu eine Reihe von Terminen mit optional mehreren Daten und Uhrzeiten — so müssen Admins nie für jeden einzelnen Termin einen neuen Eintrag anlegen.\"],\"resourceTitle\":\"Ressourcen\",\"resourceTags\":[\"Ressourcenteilung\",\"Verwaltung von Gemeingütern\"],\"resources\":[\"Cocoso ermöglicht die rechtzeitige Planung und Übersicht von Prozessen zur Ressourcenteilung. Jedes Mal, wenn ein verifizierter Nutzer eine physische Ressource beansprucht oder einen Raum bucht, wird diese Information über den Kalender mit den Mitgliedern des Kollektivs geteilt.\",\"Es gibt keine Kalendereinladungen. Wir glauben, dass Maschinen uns nur helfen sollten, unsere eigene Kommunikation und unser Teilen zu erleichtern — nicht für uns zu handeln. Cocosos Kalender ist die zentrale Fassade für Gemeinschaftsveranstaltungen und Ressourcenteilung, damit wir weiterhin miteinander sprechen, so wie wir unsere E-Mails vom Datenwust befreien.\"],\"calendarTitle\":\"Kalender\",\"calendarTags\":[\"Terminplanung\",\"Agenda\",\"Teilen von Gemeingütern\",\"Programmplanung\",\"Ressourcenbuchungen\"],\"calendar\":[\"Cocosos Webkalender kann Monats-, Wochen- oder Tagesansichten von Veranstaltungen und Ressourcen-Updates anzeigen, und Nutzer wechseln mit einem Klick zwischen diesen Zeiträumen. Jeder Eintrag kann einer Ressourcennutzung oder einer Gemeinschaftsveranstaltung entsprechen.\",\"Jedem Eintrag kann eine Kategorie zugewiesen werden — eine gebuchte Ressource oder eine Aktivitätsart wie Yoga — nützlich sowohl für öffentliche Aktivitätslisten als auch für interne oder private Buchungen. Wie jede Funktion in Cocoso ist sie bewusst abstrakt genug gehalten, um auf ganz unterschiedliche Anwendungsfälle zu passen.\"],\"groupTitle\":\"Gruppen\",\"groupTags\":[\"Lerngruppen\",\"Schulen\",\"Ko-Kreation\",\"Wiederkehrende Termine\",\"Geteilte Dokumente\",\"Mitgliederaktivitäten\"],\"groups\":[\"Eine Gruppe ist ein Konzept und eine Reihe konzeptuell verbundener Aktivitäten, die von einer Gruppe von Menschen verfolgt werden — virtuell oder vor Ort. Innerhalb einer Gruppe können Mitglieder gemeinsame Aktivitäten durchführen, wobei alle praktischen Details, Grundinformationen und Termine auf einer Seite dokumentiert sind.\",\"Gruppen ermöglichen die Organisation von Schulungen, sozialen oder Lernaktivitäten — wiederkehrende Yoga-Sessions, Schulhalbjahre oder jede Art von Ko-Kreation und sich stetig weiterentwickelndem Prozess. Admins richten eine Gruppe mit einem Bild und etwas Text ein, und ein einfaches Forum, eine Dokumentenliste, eine Mitgliederliste und Termine stehen auf einer Seite bereit.\",\"Im Kern ist es das Werkzeugset, um eine Schule, eine wiederkehrende Session oder jede Art von kooperativer Aktivität zu betreiben.\"],\"workTitle\":\"Werke\",\"workTags\":[\"Portfolio\",\"Marktplatz\",\"Dokumentation\",\"Präsentation\"],\"works\":[\"Ein Werk ist eine visuelle oder audiovisuelle Schöpfung einer Künstlerin, Forscherin, Designerin, eines Handwerkers oder Wiederverkäufers, die der Gemeinschaft präsentiert wird. Details, Bilder, Audiodateien und Videos können innerhalb einer selbst gewählten Kategorie geteilt werden — ein Werkzeug für Portfolios ebenso wie für Marktplätze.\",\"Ein Werk kann auch privat gespeichert werden, für internen Gebrauch und zur Dokumentation. Es ist dafür gebaut, Künstler:innen und Handwerker:innen zu ermöglichen, das, was sie tun, mit der Welt zu teilen und zugleich ein eigenes Archiv zu führen.\"],\"memberTitle\":\"Mitglieder\",\"memberTags\":[\"Mitgliederverwaltung\",\"Gemeinschaft\",\"Mitgliedschaften\",\"Verifizierung\",\"Rollen \\u0026 Rechte\",\"Follower\"],\"members\":[\"Admins können jedes Mitglied der Organisation an einem Ort finden, filtern und verwalten: Personen verifizieren oder die Verifizierung entziehen, um bestimmte Rechte zu vergeben, etwa Aktivitäten im Kalender zu veröffentlichen oder eine Gruppe zu starten.\",\"Wer zum Beispiel ein Yoga-Studio betreibt, hat Lehrende und Teilnehmende auf derselben Plattform — verifizieren Sie Ihre Lehrenden, damit sie eigene Aktivitäten erstellen können, während Teilnehmende einfach mitmachen und sich anmelden.\",\"Rechte werden sinnvoll innerhalb der Gemeinschaft verteilt, und jeder Nutzer erstellt und verwaltet sein eigenes Konto. Passwörter werden automatisch verschlüsselt, sodass Systemadmins sie weder lesen noch nachverfolgen können.\"],\"pagesTitle\":\"Frei gestaltbare Seiten\",\"pagesTags\":[\"Drag \\u0026 Drop\",\"Landingpages\",\"Kampagnen\",\"Statische Seiten\",\"Kein Code nötig\"],\"pages\":[\"Bauen Sie frei eine Landingpage, eine Kampagnenseite oder jede statische Seite, die Ihre Gemeinschaft braucht — mit Drag-and-Drop-Blöcken für Text, Bilder und Layout, ganz ohne Code. Was einmal Cocosos einfachstes CMS war, ist heute ein echter Seitenbaukasten.\",\"Jede Seite wird automatisch Teil Ihrer Navigation. Nutzen Sie sie für eine Über-uns-Seite, ein Set von AGB, eine einmalige Kampagne, oder einen ganz neuen Bereich Ihrer Website — frei zusammengestellt, sofort veröffentlicht.\"],\"adminTitle\":\"Admin-Panel\",\"adminTags\":[\"Organisation einrichten\",\"Branding\",\"Menü \\u0026 Navigation\",\"Header \\u0026 Footer\",\"Einstellungen\"],\"admin\":[\"Ein eigenes Admin-Panel, um Ihre Organisation von Grund auf einzurichten: Name, Logo, Kontaktdaten und jede Einstellung, die prägt, wie sich Ihre Gemeinschaft präsentiert — ganz ohne Code.\",\"Passen Sie Menü, Header und Footer an und entscheiden Sie genau, was Besucher zuerst sehen. Es ist die Kommandozentrale hinter jeder Cocoso-Gemeinschaft, gebaut für Admins, nicht für Entwickler.\"],\"designTitle\":\"Design-Einstellungen\",\"designTags\":[\"Farben\",\"Eckenradius\",\"Hintergründe\",\"Look \\u0026 Feel\"],\"design\":[\"Geben Sie der Website Ihrer Gemeinschaft eine eigene visuelle Identität: Wählen Sie Ihre Farben, passen Sie den Eckenradius an, legen Sie einen Hintergrund fest — machen Sie sie unverwechselbar Ihre eigene, ohne eine einzige Zeile CSS anzufassen.\",\"Design-Einstellungen gelten auf einmal für Ihre gesamte Website, sodass der Auftritt Ihrer Gemeinschaft stimmig bleibt, während sie wächst — von der Startseite über den Kalender bis zu jeder frei gestalteten Seite.\"],\"newsletterTitle\":\"Newsletter \\u0026 E-Mails\",\"newsletterTags\":[\"E-Mail-Newsletter\",\"Automatische E-Mails\",\"Mitgliederkommunikation\"],\"newsletter\":[\"Erreichen Sie jedes Mitglied direkt mit einem E-Mail-Newsletter — kein separates Mailing-Tool nötig. Einmal schreiben, an die ganze Gemeinschaft senden, und Menschen auf dem Laufenden halten, ohne sich auf ein soziales Netzwerk zu verlassen.\",\"Automatische E-Mails übernehmen die Routineaufgaben für Sie: Anmeldebestätigungen, Verifizierungen von Zusagen und andere Mitgliederbenachrichtigungen gehen von selbst hinaus, sodass Admins sich auf die Gemeinschaft statt auf den Posteingang konzentrieren können.\"]},\"clients\":{\"pageTitle\":\"Anwendungsbeispiele\",\"pageLead\":\"Echte Gemeinschaften, Studios und Künstler:innen, die bereits mit Cocoso arbeiten — föderierte Netzwerke, gemeinsame Arbeitsräume, Veranstaltungskalender und persönliche Portfolios, jeweils passend zugeschnitten.\",\"samarbetetTitle\":\"Samarbetet\",\"samarbetetTags\":[\"Schweden\",\"Föderation\",\"Künstler \\u0026 Kulturräume\"],\"samarbetet\":[\"Samarbetet ist eine Föderation unabhängiger Gemeinschaften in ganz Schweden — Künstler:innen, Kulturräume, Gärten, Werkstätten und Menschen, verbunden in einem gemeinsamen Netzwerk.\",\"Die Mitglieder teilen Bühnen, Gärten, Werkstätten und Treffpunkte, betreiben eigene Programme und Shops und bleiben unabhängig, während sie von einer gemeinsamen Eingangstür zum gesamten Ökosystem profitieren.\"],\"samarbetetLinkLabel\":\"samarbetet.org besuchen\",\"kkvTitle\":\"KKV Stockholm\",\"kkvTags\":[\"Ressourcenbuchung\",\"200+ Ressourcen\",\"400+ Mitglieder\"],\"kkv\":[\"KKV Stockholm — Konstnärernas Kollektivverkstad — ist eine Gemeinschaftswerkstatt für professionelle Künstler:innen und gibt über 400 Mitgliedern gemeinsamen Zugang zu mehr als 200 Ausrüstungsgegenständen und Werkstattflächen.\",\"Mitglieder buchen Ressourcen über den Kalender von Cocoso, veröffentlichen ihre eigenen Portfolios und öffentlichen Veranstaltungen und finden sich auf einer gemeinsamen Mitgliederseite — eine große, geschäftige Werkstatt, die reibungslos auf einer einzigen Plattform läuft.\"],\"kkvLinkLabel\":\"stockholm.kkv.nu besuchen\",\"hojdenTitle\":\"höjden\",\"hojdenTags\":[\"Künstlerisch geführter Raum\",\"Ressourcenbuchung\",\"Portfolios\"],\"hojden\":[\"höjden ist ein künstlerisch geführter Raum in Stockholm — Studios, eine Bühne, eine Tanzfläche, eine Galerie und eine Küche, seit 2018 gemeinschaftlich betrieben von der Genossenschaft Släktet.\",\"Wie KKV nutzt höjden Cocoso, um Buchungen seiner gemeinsamen Räume und Ausrüstung zu verwalten, zusammen mit Mitgliederportfolios und einem öffentlichen Programm aus Workshops, Aufführungen und Vorträgen.\"],\"hojdenLinkLabel\":\"hojden.house besuchen\",\"gerlesborgTitle\":\"Gerlesborgs Kulturhus\",\"gerlesborgTags\":[\"Kulturzentrum\",\"Öffentliche Veranstaltungen\",\"Kalender\"],\"gerlesborg\":[\"Gerlesborgs kulturhus ist ein Kulturzentrum in Hamburgsund, Schweden, das Ausstellungen, Konzerte, Workshops und ein Literaturfestival für die umliegende Gemeinschaft veranstaltet.\",\"Es nutzt Cocoso einfach und effektiv, um sein öffentliches Programm zu veröffentlichen — jede Ausstellung, jedes Konzert und jeder Kurs erscheint direkt im Kalender, ganz ohne separates Veranstaltungstool.\"],\"gerlesborgLinkLabel\":\"gerlesborgskulturhus.se besuchen\",\"minaTitle\":\"Mîna Kocailik\",\"minaTags\":[\"Portfolio\",\"Unabhängige Künstlerin\"],\"mina\":[\"Mîna Kocailik ist eine unabhängige Künstlerin, die Cocoso schlicht nutzt, um ihr Portfolio zu veröffentlichen: eine klare, selbstverwaltete Präsentation ihrer Arbeit, ohne zusätzlichen Pflegeaufwand.\",\"Es ist die kleinstmögliche Nutzung von Cocoso — der Beweis, dass dieselbe Plattform, die Föderationen mit Hunderten von Mitgliedern bedient, genauso gut für eine einzelne künstlerische Praxis funktioniert.\"],\"minaLinkLabel\":\"Ihr Portfolio besuchen\"},\"credits\":{\"title\":\"Credits\",\"first\":\"Entwickelt in einer fantastischen Zusammenarbeit mit\",\"second\":\"Unterstützt von\"},\"contact\":{\"title\":\"Kontakt\",\"heading\":\"Lassen Sie uns zusammenarbeiten\",\"body\":\"Haben Sie ein Projekt, für das Cocoso nützlich sein könnte? Oder möchten Sie einfach Hallo sagen und Freunde werden? Hinterlassen Sie uns hier eine Nachricht, wir melden uns bei Ihnen!\",\"email\":\"Ihre E-Mail-Adresse\",\"subject\":\"Betreff\",\"message\":\"Nachricht\",\"send\":\"Senden\"},\"footer\":{\"tagline\":\"Open-Source-Software für Föderationen von Gemeinschaften, Genossenschaften und Basisgruppen — eine öffentliche Website und ein Intranet, immer zu Ihren eigenen Bedingungen.\",\"exploreTitle\":\"Entdecken\",\"projectTitle\":\"Projekt\",\"license\":\"Frei und quelloffen, lizenziert unter der GNU GPLv3.\",\"bottom\":\"© {{year}} Cocoso. Gebaut für autonome Gemeinschaften überall.\"},\"source\":\"Quelle\"}}},\"__N_SSG\":true},\"page\":\"/clients\",\"query\":{},\"buildId\":\"LW3_3LAUpC0drtG0hmwrQ\",\"isFallback\":false,\"gsp\":true,\"locale\":\"de\",\"locales\":[\"en\",\"sv\",\"tr\",\"de\",\"es\",\"pt-PT\",\"pt-BR\"],\"defaultLocale\":\"en\",\"scriptLoader\":[]}</script></body></html>","json":{"pageProps":{"__lang":"de","__namespaces":{"common":{"meta":{"title":"Cocoso — Software für Gemeinschaftskooperation","description":"Open-Source-Software für Föderationen von Gemeinschaften, Genossenschaften und Basisgruppen — Kalender, Ressourcen, Veranstaltungen, Gruppen, frei gestaltbare Seiten und mehr, immer zu Ihren eigenen Bedingungen."},"brand":{"title":"COCOSO","slogan":"Software für Gemeinschaftskooperation"},"nav":{"home":"Start","features":"Funktionen","examples":"Beispiele","contact":"Kontakt","sourceCode":"Quellcode","getStarted":"Funktionen entdecken","demo":"Live-Demo","language":"Sprache"},"home":{"leadTitle":"Software für autonome, föderierte Gemeinschaften","lead":["Cocoso ist Open-Source-Software für autonome Gemeinschaften: eine öffentliche Website und ein Intranet, an einem Ort. Gebaut für Genossenschaften, Ökodörfer, künstlerisch geführte Räume, Festivals und Basisgruppen, die ihre eigenen Abläufe zu ihren eigenen Bedingungen führen wollen.","Ein Login. Viele Gemeinschaften. Ihre Daten, immer Ihre eigenen."],"leadTags":["Online-Plattformen","Genossenschaften","Non-Profits","Festivals","Konferenzen","Künstlerisch geführte Räume","Ökodörfer","Gemeinschaften","Zeltplätze"],"tripleTitle":"Mehr als eine Website","tripleTags":["Öffentliche Website","Gemeinschaftsnetzwerk","Produktivitätstool"],"triple":["Cocoso ist eine öffentliche Website, damit die Welt sehen kann, wer Sie sind, was Sie tun und was ansteht — keine separate Seite nötig.","Es ist zugleich ein privates Gemeinschaftsnetzwerk: Mitglieder können Aktivitäten folgen, Updates teilen und miteinander in Verbindung bleiben — ohne Werbung, Algorithmen oder Tracking. Soziale Medien, minus der Ausbeutung.","Und es ist ein echtes Produktivitätswerkzeug für die praktische Seite des Gemeinschaftslebens: ein gemeinsamer Kalender, Ressourcenbuchungen, Anmeldungen und Admin-Werkzeuge, die alle auf demselben Stand halten."],"federationTitle":"Föderation","federationTags":["Netzwerk aus Gemeinschaften","Portal","Gemeinsame Auffindbarkeit","Autonom per Default"],"federation":["Cocoso ist nicht auf eine einzelne Gruppe beschränkt. Eine einzige Installation kann eine ganze Föderation unabhängiger Gemeinschaften beherbergen — jede mit eigener Domain, eigenem Erscheinungsbild, eigenen Mitgliedern — und trotzdem als Teil eines größeren Netzwerks auffindbar bleiben.","Eine Föderation kann eine Gemeinschaft als ihr Portal bestimmen: eine gemeinsame Eingangstür, über die Besucher jede Mitgliedsgemeinschaft durchstöbern, Aktivitäten netzwerkweit filtern und ihren Weg finden. Jede Gemeinschaft bleibt unabhängig; das Netzwerk bleibt zusammenhängend.","Das passt natürlich zu einer Bewegung aus vielen autonomen Gruppen — etwa einem Netzwerk aus Ökodörfern, Genossenschaften oder Basisinitiativen, die zusammenstehen wollen, ohne ihre lokale Selbstverwaltung aufzugeben."],"accountsTitle":"Ein Login, viele Gemeinschaften","accountsTags":["Globale Konten","Rollen pro Gemeinschaft","Portable Identität","Verifizierte Mitgliedschaft"],"accounts":["Jede Person hat ein einziges Cocoso-Konto, ganz gleich, wo ihre Gemeinschaften angesiedelt sind. Treten Sie hier einer Genossenschaft bei, dort einem Festival, anderswo einem Ökodorf — eine Identität begleitet Sie, während Rolle und Sichtbarkeit an jedem Ort unabhängig festgelegt werden.","Admins verifizieren Mitglieder gemeinschaftsweise und vergeben so das Recht, Aktivitäten zu veröffentlichen, eine Gruppe zu leiten oder Ressourcen vor Ort zu verwalten — ohne je die Einstellungen oder Mitglieder einer anderen Gemeinschaft anzutasten."],"dataTitle":"Ihre Daten gehören Ihnen","dataTags":["Kein Tracking","Keine Drittanbieter","Datensouveränität","Privacy by Design"],"data":["Cocoso enthält keine Werkzeuge, um Nutzer auszuspähen oder ihre Daten zu verfolgen. Es werden keine Informationen an Drittanbieter oder Werbetreibende weitergegeben — die Daten gehören der Gemeinschaft, die sie erzeugt hat, Punkt.","Jedes Mitglied entscheidet selbst, wie viel es von seinen eigenen Informationen teilt, und jede Gemeinschaft entscheidet, wie viel ihrer Aktivität sie der weiteren Föderation zeigt. Sie führen Ihre Projekte — und Ihre Daten — zu Ihren eigenen Bedingungen."],"openSourceTitle":"Open Source","openSourceTags":["Selbst hostbar","Community-getrieben","Transparent","Frei wie in Freiheit"],"openSource":["Cocoso ist freie, quelloffene Software, die offen entwickelt wird — Sie können jede Zeile davon lesen, sie auf Ihrem eigenen Server betreiben oder einem Hoster Ihrer Wahl vertrauen. Kein Vendor-Lock-in, keine Blackbox.","Geprägt wird sie von den Gemeinschaften, die sie nutzen: Künstler:innen, Genossenschaften, alternative Währungsprojekte und Orte des gemeinsamen Schaffens, die seit den frühesten Tagen reale Bedürfnisse in das Projekt zurückspielen."],"ctaTitle":"Sehen Sie, was Cocoso alles kann","ctaBody":"Vom Kalender bis zum Admin-Panel — jede Funktion ist so gebaut, dass eine Gemeinschaft sie selbst nutzen kann, nicht nur ein Webmaster. Entdecken Sie, was drinsteckt.","ctaButton":"Funktionen entdecken","ctaSecondary":"Oder sagen Sie einfach Hallo"},"features":{"pageTitle":"Funktionen","pageLead":"Cocoso im Detail — jedes Werkzeug, das Ihre Gemeinschaft nutzen kann, und wie es funktioniert.","groupCommunityTitle":"Für Ihre Gemeinschaft","groupAdminTitle":"Für Admins","activityTitle":"Aktivitäten","activityTags":["Öffentliche Veranstaltungen","Anmeldung","Work-in-Progress","Aufführungen","Ausstellungen","Konzerte","Konferenzen","Interne Termine","Buchungen"],"activities":["Die früheste Version von Cocoso wurde für ein künstlerisch geführtes Tanztheater und einen gemeinsamen Lernraum gebaut, der mehrere öffentliche Bühnenauftritte für vorab angemeldetes Publikum ausrichtete. Das Verwalten und Veröffentlichen anpassbarer, wiederkehrender Veranstaltungen erfordert mehrere unterschiedliche Funktionen, Anmeldung eingeschlossen. Anmeldungen werden den Gästen per E-Mail bestätigt, und Veranstaltungsadmins können Ankünfte an der Tür verifizieren.","Sie können Inhalte mit Bild, Titel, Beschreibung und weiteren Informationen erstellen, bearbeiten und löschen, dazu eine Reihe von Terminen mit optional mehreren Daten und Uhrzeiten — so müssen Admins nie für jeden einzelnen Termin einen neuen Eintrag anlegen."],"resourceTitle":"Ressourcen","resourceTags":["Ressourcenteilung","Verwaltung von Gemeingütern"],"resources":["Cocoso ermöglicht die rechtzeitige Planung und Übersicht von Prozessen zur Ressourcenteilung. Jedes Mal, wenn ein verifizierter Nutzer eine physische Ressource beansprucht oder einen Raum bucht, wird diese Information über den Kalender mit den Mitgliedern des Kollektivs geteilt.","Es gibt keine Kalendereinladungen. Wir glauben, dass Maschinen uns nur helfen sollten, unsere eigene Kommunikation und unser Teilen zu erleichtern — nicht für uns zu handeln. Cocosos Kalender ist die zentrale Fassade für Gemeinschaftsveranstaltungen und Ressourcenteilung, damit wir weiterhin miteinander sprechen, so wie wir unsere E-Mails vom Datenwust befreien."],"calendarTitle":"Kalender","calendarTags":["Terminplanung","Agenda","Teilen von Gemeingütern","Programmplanung","Ressourcenbuchungen"],"calendar":["Cocosos Webkalender kann Monats-, Wochen- oder Tagesansichten von Veranstaltungen und Ressourcen-Updates anzeigen, und Nutzer wechseln mit einem Klick zwischen diesen Zeiträumen. Jeder Eintrag kann einer Ressourcennutzung oder einer Gemeinschaftsveranstaltung entsprechen.","Jedem Eintrag kann eine Kategorie zugewiesen werden — eine gebuchte Ressource oder eine Aktivitätsart wie Yoga — nützlich sowohl für öffentliche Aktivitätslisten als auch für interne oder private Buchungen. Wie jede Funktion in Cocoso ist sie bewusst abstrakt genug gehalten, um auf ganz unterschiedliche Anwendungsfälle zu passen."],"groupTitle":"Gruppen","groupTags":["Lerngruppen","Schulen","Ko-Kreation","Wiederkehrende Termine","Geteilte Dokumente","Mitgliederaktivitäten"],"groups":["Eine Gruppe ist ein Konzept und eine Reihe konzeptuell verbundener Aktivitäten, die von einer Gruppe von Menschen verfolgt werden — virtuell oder vor Ort. Innerhalb einer Gruppe können Mitglieder gemeinsame Aktivitäten durchführen, wobei alle praktischen Details, Grundinformationen und Termine auf einer Seite dokumentiert sind.","Gruppen ermöglichen die Organisation von Schulungen, sozialen oder Lernaktivitäten — wiederkehrende Yoga-Sessions, Schulhalbjahre oder jede Art von Ko-Kreation und sich stetig weiterentwickelndem Prozess. Admins richten eine Gruppe mit einem Bild und etwas Text ein, und ein einfaches Forum, eine Dokumentenliste, eine Mitgliederliste und Termine stehen auf einer Seite bereit.","Im Kern ist es das Werkzeugset, um eine Schule, eine wiederkehrende Session oder jede Art von kooperativer Aktivität zu betreiben."],"workTitle":"Werke","workTags":["Portfolio","Marktplatz","Dokumentation","Präsentation"],"works":["Ein Werk ist eine visuelle oder audiovisuelle Schöpfung einer Künstlerin, Forscherin, Designerin, eines Handwerkers oder Wiederverkäufers, die der Gemeinschaft präsentiert wird. Details, Bilder, Audiodateien und Videos können innerhalb einer selbst gewählten Kategorie geteilt werden — ein Werkzeug für Portfolios ebenso wie für Marktplätze.","Ein Werk kann auch privat gespeichert werden, für internen Gebrauch und zur Dokumentation. Es ist dafür gebaut, Künstler:innen und Handwerker:innen zu ermöglichen, das, was sie tun, mit der Welt zu teilen und zugleich ein eigenes Archiv zu führen."],"memberTitle":"Mitglieder","memberTags":["Mitgliederverwaltung","Gemeinschaft","Mitgliedschaften","Verifizierung","Rollen & Rechte","Follower"],"members":["Admins können jedes Mitglied der Organisation an einem Ort finden, filtern und verwalten: Personen verifizieren oder die Verifizierung entziehen, um bestimmte Rechte zu vergeben, etwa Aktivitäten im Kalender zu veröffentlichen oder eine Gruppe zu starten.","Wer zum Beispiel ein Yoga-Studio betreibt, hat Lehrende und Teilnehmende auf derselben Plattform — verifizieren Sie Ihre Lehrenden, damit sie eigene Aktivitäten erstellen können, während Teilnehmende einfach mitmachen und sich anmelden.","Rechte werden sinnvoll innerhalb der Gemeinschaft verteilt, und jeder Nutzer erstellt und verwaltet sein eigenes Konto. Passwörter werden automatisch verschlüsselt, sodass Systemadmins sie weder lesen noch nachverfolgen können."],"pagesTitle":"Frei gestaltbare Seiten","pagesTags":["Drag & Drop","Landingpages","Kampagnen","Statische Seiten","Kein Code nötig"],"pages":["Bauen Sie frei eine Landingpage, eine Kampagnenseite oder jede statische Seite, die Ihre Gemeinschaft braucht — mit Drag-and-Drop-Blöcken für Text, Bilder und Layout, ganz ohne Code. Was einmal Cocosos einfachstes CMS war, ist heute ein echter Seitenbaukasten.","Jede Seite wird automatisch Teil Ihrer Navigation. Nutzen Sie sie für eine Über-uns-Seite, ein Set von AGB, eine einmalige Kampagne, oder einen ganz neuen Bereich Ihrer Website — frei zusammengestellt, sofort veröffentlicht."],"adminTitle":"Admin-Panel","adminTags":["Organisation einrichten","Branding","Menü & Navigation","Header & Footer","Einstellungen"],"admin":["Ein eigenes Admin-Panel, um Ihre Organisation von Grund auf einzurichten: Name, Logo, Kontaktdaten und jede Einstellung, die prägt, wie sich Ihre Gemeinschaft präsentiert — ganz ohne Code.","Passen Sie Menü, Header und Footer an und entscheiden Sie genau, was Besucher zuerst sehen. Es ist die Kommandozentrale hinter jeder Cocoso-Gemeinschaft, gebaut für Admins, nicht für Entwickler."],"designTitle":"Design-Einstellungen","designTags":["Farben","Eckenradius","Hintergründe","Look & Feel"],"design":["Geben Sie der Website Ihrer Gemeinschaft eine eigene visuelle Identität: Wählen Sie Ihre Farben, passen Sie den Eckenradius an, legen Sie einen Hintergrund fest — machen Sie sie unverwechselbar Ihre eigene, ohne eine einzige Zeile CSS anzufassen.","Design-Einstellungen gelten auf einmal für Ihre gesamte Website, sodass der Auftritt Ihrer Gemeinschaft stimmig bleibt, während sie wächst — von der Startseite über den Kalender bis zu jeder frei gestalteten Seite."],"newsletterTitle":"Newsletter & E-Mails","newsletterTags":["E-Mail-Newsletter","Automatische E-Mails","Mitgliederkommunikation"],"newsletter":["Erreichen Sie jedes Mitglied direkt mit einem E-Mail-Newsletter — kein separates Mailing-Tool nötig. Einmal schreiben, an die ganze Gemeinschaft senden, und Menschen auf dem Laufenden halten, ohne sich auf ein soziales Netzwerk zu verlassen.","Automatische E-Mails übernehmen die Routineaufgaben für Sie: Anmeldebestätigungen, Verifizierungen von Zusagen und andere Mitgliederbenachrichtigungen gehen von selbst hinaus, sodass Admins sich auf die Gemeinschaft statt auf den Posteingang konzentrieren können."]},"clients":{"pageTitle":"Anwendungsbeispiele","pageLead":"Echte Gemeinschaften, Studios und Künstler:innen, die bereits mit Cocoso arbeiten — föderierte Netzwerke, gemeinsame Arbeitsräume, Veranstaltungskalender und persönliche Portfolios, jeweils passend zugeschnitten.","samarbetetTitle":"Samarbetet","samarbetetTags":["Schweden","Föderation","Künstler & Kulturräume"],"samarbetet":["Samarbetet ist eine Föderation unabhängiger Gemeinschaften in ganz Schweden — Künstler:innen, Kulturräume, Gärten, Werkstätten und Menschen, verbunden in einem gemeinsamen Netzwerk.","Die Mitglieder teilen Bühnen, Gärten, Werkstätten und Treffpunkte, betreiben eigene Programme und Shops und bleiben unabhängig, während sie von einer gemeinsamen Eingangstür zum gesamten Ökosystem profitieren."],"samarbetetLinkLabel":"samarbetet.org besuchen","kkvTitle":"KKV Stockholm","kkvTags":["Ressourcenbuchung","200+ Ressourcen","400+ Mitglieder"],"kkv":["KKV Stockholm — Konstnärernas Kollektivverkstad — ist eine Gemeinschaftswerkstatt für professionelle Künstler:innen und gibt über 400 Mitgliedern gemeinsamen Zugang zu mehr als 200 Ausrüstungsgegenständen und Werkstattflächen.","Mitglieder buchen Ressourcen über den Kalender von Cocoso, veröffentlichen ihre eigenen Portfolios und öffentlichen Veranstaltungen und finden sich auf einer gemeinsamen Mitgliederseite — eine große, geschäftige Werkstatt, die reibungslos auf einer einzigen Plattform läuft."],"kkvLinkLabel":"stockholm.kkv.nu besuchen","hojdenTitle":"höjden","hojdenTags":["Künstlerisch geführter Raum","Ressourcenbuchung","Portfolios"],"hojden":["höjden ist ein künstlerisch geführter Raum in Stockholm — Studios, eine Bühne, eine Tanzfläche, eine Galerie und eine Küche, seit 2018 gemeinschaftlich betrieben von der Genossenschaft Släktet.","Wie KKV nutzt höjden Cocoso, um Buchungen seiner gemeinsamen Räume und Ausrüstung zu verwalten, zusammen mit Mitgliederportfolios und einem öffentlichen Programm aus Workshops, Aufführungen und Vorträgen."],"hojdenLinkLabel":"hojden.house besuchen","gerlesborgTitle":"Gerlesborgs Kulturhus","gerlesborgTags":["Kulturzentrum","Öffentliche Veranstaltungen","Kalender"],"gerlesborg":["Gerlesborgs kulturhus ist ein Kulturzentrum in Hamburgsund, Schweden, das Ausstellungen, Konzerte, Workshops und ein Literaturfestival für die umliegende Gemeinschaft veranstaltet.","Es nutzt Cocoso einfach und effektiv, um sein öffentliches Programm zu veröffentlichen — jede Ausstellung, jedes Konzert und jeder Kurs erscheint direkt im Kalender, ganz ohne separates Veranstaltungstool."],"gerlesborgLinkLabel":"gerlesborgskulturhus.se besuchen","minaTitle":"Mîna Kocailik","minaTags":["Portfolio","Unabhängige Künstlerin"],"mina":["Mîna Kocailik ist eine unabhängige Künstlerin, die Cocoso schlicht nutzt, um ihr Portfolio zu veröffentlichen: eine klare, selbstverwaltete Präsentation ihrer Arbeit, ohne zusätzlichen Pflegeaufwand.","Es ist die kleinstmögliche Nutzung von Cocoso — der Beweis, dass dieselbe Plattform, die Föderationen mit Hunderten von Mitgliedern bedient, genauso gut für eine einzelne künstlerische Praxis funktioniert."],"minaLinkLabel":"Ihr Portfolio besuchen"},"credits":{"title":"Credits","first":"Entwickelt in einer fantastischen Zusammenarbeit mit","second":"Unterstützt von"},"contact":{"title":"Kontakt","heading":"Lassen Sie uns zusammenarbeiten","body":"Haben Sie ein Projekt, für das Cocoso nützlich sein könnte? Oder möchten Sie einfach Hallo sagen und Freunde werden? Hinterlassen Sie uns hier eine Nachricht, wir melden uns bei Ihnen!","email":"Ihre E-Mail-Adresse","subject":"Betreff","message":"Nachricht","send":"Senden"},"footer":{"tagline":"Open-Source-Software für Föderationen von Gemeinschaften, Genossenschaften und Basisgruppen — eine öffentliche Website und ein Intranet, immer zu Ihren eigenen Bedingungen.","exploreTitle":"Entdecken","projectTitle":"Projekt","license":"Frei und quelloffen, lizenziert unter der GNU GPLv3.","bottom":"© {{year}} Cocoso. Gebaut für autonome Gemeinschaften überall."},"source":"Quelle"}}},"__N_SSG":true}}