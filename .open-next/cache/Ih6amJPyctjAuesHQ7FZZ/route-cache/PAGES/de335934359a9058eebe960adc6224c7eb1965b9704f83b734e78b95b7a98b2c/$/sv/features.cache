{"type":"page","meta":{"routeCache":{"key":"/route-cache/PAGES/de335934359a9058eebe960adc6224c7eb1965b9704f83b734e78b95b7a98b2c/$/sv/features","owner":{"kind":"PAGES","sourceRoute":"/features"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"sv\"><head><meta charSet=\"utf-8\" data-next-head=\"\"/><meta name=\"viewport\" content=\"width=device-width\" data-next-head=\"\"/><title data-next-head=\"\"></title><meta name=\"description\" content=\"Programvara med öppen källkod för federationer av samhällen, kooperativ och gräsrotsgrupper — kalender, resurser, evenemang, grupper, komponerbara sidor och mer, alltid på dina egna villkor.\" data-next-head=\"\"/><link rel=\"preload\" href=\"/_next/static/css/544d7195a2962901.css\" as=\"style\"/><link rel=\"stylesheet\" href=\"/_next/static/css/544d7195a2962901.css\" data-n-g=\"\"/><noscript data-n-css=\"\"></noscript><script defer=\"\" noModule=\"\" src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\"></script><script src=\"/_next/static/chunks/webpack-ccef31ea74e09183.js\" defer=\"\"></script><script src=\"/_next/static/chunks/framework-ce4420da925a97d0.js\" defer=\"\"></script><script src=\"/_next/static/chunks/main-ea9a9e30635b143d.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/_app-4744dc754b095ee4.js\" defer=\"\"></script><script src=\"/_next/static/chunks/994-8e268744597e86c6.js\" defer=\"\"></script><script src=\"/_next/static/chunks/324-f5d3748c16c44ee3.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/features-bcb1a4c5825c20b6.js\" defer=\"\"></script><script src=\"/_next/static/Ih6amJPyctjAuesHQ7FZZ/_buildManifest.js\" defer=\"\"></script><script src=\"/_next/static/Ih6amJPyctjAuesHQ7FZZ/_ssgManifest.js\" defer=\"\"></script><style id=\"__jsx-8df70e60372d0001\">@import url(\"https://fonts.googleapis.com/css2?family=Sarabun:wght@500;800&family=Inknut+Antiqua:wght@700&display=swap\");</style><style data-styled=\"\" data-styled-version=\"5.3.11\">.gvavzw{font-family:'Sarabun',sans-serif;font-size:16px;line-height:24px;background-color:hsla(88,62%,90%,0.1);color:#444444;box-sizing:border-box;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;-moz-osx-font-smoothing:grayscale;-webkit-font-smoothing:antialiased;}/*!sc*/\ndata-styled.g145[id=\"StyledGrommet-sc-19lkkz7-0\"]{content:\"gvavzw,\"}/*!sc*/\n</style></head><body><link rel=\"preload\" as=\"image\" href=\"/cocoso-logo-small.png\"/><link rel=\"preload\" as=\"image\" href=\"/activities.jpeg\"/><link rel=\"preload\" as=\"image\" href=\"/resources.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/calendar.png\"/><link rel=\"preload\" as=\"image\" href=\"/processes.png\"/><link rel=\"preload\" as=\"image\" href=\"/works.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/members.png\"/><div id=\"__next\"><div class=\"StyledGrommet-sc-19lkkz7-0 gvavzw\"><nav class=\"top-nav--desktop\"><a class=\"top-nav-logo\" href=\"/sv\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"top-nav-links\"><a href=\"/sv\"><span class=\"top-nav-link\">Hem</span></a><a href=\"/sv/features\"><span class=\"top-nav-link nav-item-active\">Funktioner</span></a><a href=\"/sv/clients\"><span class=\"top-nav-link\">Exempel</span></a><a href=\"/sv/contact\"><span class=\"top-nav-link\">Kontakt</span></a></div><a class=\"btn-demo\" href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Live-demo</a><div class=\"nav-dropdown\"><button type=\"button\" class=\"lang-trigger\">Svenska<svg width=\"10\" height=\"7\" viewBox=\"0 0 10 7\" fill=\"none\"><path d=\"M1 1L5 5.5L9 1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></div></nav><nav class=\"top-nav-mobile-bar\"><a class=\"top-nav-logo\" href=\"/sv\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"nav-dropdown\"><button type=\"button\" class=\"burger-trigger\" aria-label=\"Menu\"><svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" fill=\"none\"><path d=\"M0 1H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 8H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 15H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path></svg></button></div></nav><div class=\"features-header-band\"><div class=\"features-header-blobs\"></div><div class=\"features-header-inner\"><h1 class=\"hero-title\" style=\"font-size:clamp(24px, 4vw, 34px)\">Funktioner</h1><p class=\"hero-lead\">Cocoso i detalj — varje verktyg ditt samhälle kan använda, och hur det fungerar.</p></div></div><div class=\"quick-nav reveal-fade\"><div class=\"quick-nav-group\"><p class=\"quick-nav-group-label\">För ditt samhälle</p><div class=\"quick-nav-row\"><a class=\"quick-nav-chip\" href=\"#Aktiviteter\" style=\"background:#FFE3DD;--chip-accent:#FF6F59\">Aktiviteter</a><a class=\"quick-nav-chip\" href=\"#Resurser\" style=\"background:#FFF1D6;--chip-accent:#FFB84C\">Resurser</a><a class=\"quick-nav-chip\" href=\"#Kalender\" style=\"background:#DFF3E7;--chip-accent:#3FA772\">Kalender</a><a class=\"quick-nav-chip\" href=\"#Grupper\" style=\"background:#DDEFFF;--chip-accent:#3DA9FC\">Grupper</a><a class=\"quick-nav-chip\" href=\"#Verk\" style=\"background:#EAE3FF;--chip-accent:#8C6FF7\">Verk</a></div></div><div class=\"quick-nav-group\"><p class=\"quick-nav-group-label\">För administratörer</p><div class=\"quick-nav-row\"><a class=\"quick-nav-chip\" href=\"#Medlemmar\" style=\"background:#FFE1EF;--chip-accent:#F45D9E\">Medlemmar</a><a class=\"quick-nav-chip\" href=\"#Komponerbara sidor\" style=\"background:#DBF6F3;--chip-accent:#2EC4B6\">Komponerbara sidor</a><a class=\"quick-nav-chip\" href=\"#Adminpanel\" style=\"background:#FBDEE1;--chip-accent:#D7263D\">Adminpanel</a><a class=\"quick-nav-chip\" href=\"#Designinställningar\" style=\"background:#FFF6D9;--chip-accent:#F2B705\">Designinställningar</a><a class=\"quick-nav-chip\" href=\"#Nyhetsbrev och e-post\" style=\"background:#DAF0F6;--chip-accent:#1B7F9E\">Nyhetsbrev och e-post</a></div></div></div><div class=\"section-group-divider reveal-fade\"><h3 class=\"section-group-divider-title\">För ditt samhälle</h3></div><section id=\"Aktiviteter\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/activities-mcgill-library-1Rbv8ubJix0-unsplash.jpg);--accent:#FF6F59;--accent-soft:#FFE3DD;--accent-deep:#0F3D3E\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#FF6F59\"><div class=\"story-index\" style=\"--accent-transparent:#FF6F59b3\">01</div><h2 class=\"story-title\">Aktiviteter</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(36, 70%, 82%, 1)\">Offentliga evenemang</span><span class=\"tag-chip\" style=\"background:hsla(72, 70%, 82%, 1)\">OSA</span><span class=\"tag-chip\" style=\"background:hsla(108, 70%, 82%, 1)\">Pågående arbete</span><span class=\"tag-chip\" style=\"background:hsla(144, 70%, 82%, 1)\">Föreställningar</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Utställningar</span><span class=\"tag-chip\" style=\"background:hsla(216, 70%, 82%, 1)\">Konserter</span><span class=\"tag-chip\" style=\"background:hsla(252, 70%, 82%, 1)\">Konferenser</span><span class=\"tag-chip\" style=\"background:hsla(288, 70%, 82%, 1)\">Internt</span><span class=\"tag-chip\" style=\"background:hsla(324, 70%, 82%, 1)\">Bokningar</span></div><img class=\"story-image\" src=\"/activities.jpeg\" alt=\"Aktiviteter\"/><p class=\"story-text\">Den tidigaste versionen av Cocoso byggdes för en artistdriven dansteater och ett samlärande utrymme, som är värd för flera offentliga scenframträdanden för förregistrerad publik. Hantering och publicering av anpassningsbara och återkommande evenemang kräver flera olika funktioner, OSA bland dem. Registreringar kommuniceras till gästerna via e-post, och evenemangsadministratörer kan verifiera ankomster vid dörren.</p></div></div></section><section id=\"Resurser\" class=\"story-section\"><div class=\"story-bg story-bg--top\" style=\"background-image:url(/slider/resources-mcgill-library---DJjEqekIM-unsplash.jpg);--accent:#FFB84C;--accent-soft:#FFF1D6;--accent-deep:#1B2A4A\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#FFB84C\"><div class=\"story-index\" style=\"--accent-transparent:#FFB84Cb3\">02</div><h2 class=\"story-title\">Resurser</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(120, 70%, 82%, 1)\">Resursdelning</span><span class=\"tag-chip\" style=\"background:hsla(240, 70%, 82%, 1)\">Förvaltning av allmänningar</span></div><img class=\"story-image\" src=\"/resources.jpg\" alt=\"Resurser\"/><p class=\"story-text\">Cocoso möjliggör planering och överblick över resursdelningsprocesser i god tid. Varje gång en verifierad användare gör anspråk på en fysisk resurs eller bokar ett utrymme delas den informationen med medlemmar i kollektivet genom kalendern.</p></div></div></section><section id=\"Kalender\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/calendar-birmingham-museums-trust-RpELX3wVm_U-unsplash.jpg);--accent:#3FA772;--accent-soft:#DFF3E7;--accent-deep:#3D1220\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#3FA772\"><div class=\"story-index\" style=\"--accent-transparent:#3FA772b3\">03</div><h2 class=\"story-title\">Kalender</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(60, 70%, 82%, 1)\">Schemaläggning</span><span class=\"tag-chip\" style=\"background:hsla(120, 70%, 82%, 1)\">Dagordning</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Delning av allmänningar</span><span class=\"tag-chip\" style=\"background:hsla(240, 70%, 82%, 1)\">Programmering av aktiviteter</span><span class=\"tag-chip\" style=\"background:hsla(300, 70%, 82%, 1)\">Bokning av resurser</span></div><img class=\"story-image\" src=\"/calendar.png\" alt=\"Kalender\"/><p class=\"story-text\">Cocosos webbkalender kan visa månads-, vecko- eller dagshändelser och resursuppdateringar, och användare kan navigera mellan dessa tidsramar med ett enda tryck. Varje post kan motsvara en resursanvändningsaktivitet eller en samhällshändelse.</p></div></div></section><section id=\"Grupper\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/processes-mcgill-library-IpZCihceRkQ-unsplash.jpg);--accent:#3DA9FC;--accent-soft:#DDEFFF;--accent-deep:#4A2A12\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#3DA9FC\"><div class=\"story-index\" style=\"--accent-transparent:#3DA9FCb3\">04</div><h2 class=\"story-title\">Grupper</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(51.42857142857143, 70%, 82%, 1)\">Studiegrupper</span><span class=\"tag-chip\" style=\"background:hsla(102.85714285714286, 70%, 82%, 1)\">Skolor</span><span class=\"tag-chip\" style=\"background:hsla(154.28571428571428, 70%, 82%, 1)\">Samskapande</span><span class=\"tag-chip\" style=\"background:hsla(205.71428571428572, 70%, 82%, 1)\">Återkommande händelser</span><span class=\"tag-chip\" style=\"background:hsla(257.14285714285717, 70%, 82%, 1)\">Delade dokument</span><span class=\"tag-chip\" style=\"background:hsla(308.57142857142856, 70%, 82%, 1)\">Medlemsaktiviteter</span></div><img class=\"story-image\" src=\"/processes.png\" alt=\"Grupper\"/><p class=\"story-text\">En Grupp är ett koncept, och en uppsättning konceptuellt drivna aktiviteter som drivs av en uppsättning människor — virtuellt eller på plats. Under en grupp kan medlemmar genomföra samarbetsaktiviteter med alla praktiska detaljer, grundläggande information och datum dokumenterade på en sida.</p></div></div></section><section id=\"Verk\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/works-boston-public-library-awhvI865NQk-unsplash.jpg);--accent:#8C6FF7;--accent-soft:#EAE3FF;--accent-deep:#2E3B12\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#8C6FF7\"><div class=\"story-index\" style=\"--accent-transparent:#8C6FF7b3\">05</div><h2 class=\"story-title\">Verk</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(72, 70%, 82%, 1)\">Portfölj</span><span class=\"tag-chip\" style=\"background:hsla(144, 70%, 82%, 1)\">Marknadsplats</span><span class=\"tag-chip\" style=\"background:hsla(216, 70%, 82%, 1)\">Dokumentation</span><span class=\"tag-chip\" style=\"background:hsla(288, 70%, 82%, 1)\">Presentation</span></div><img class=\"story-image\" src=\"/works.jpg\" alt=\"Verk\"/><p class=\"story-text\">Ett Verk är en visuell, eller audiovisuell, skapelse av en konstnär, forskare, designer, hantverkare eller återförsäljare, presenterad för samhället. Detaljer, bilder, ljudfiler och videor kan delas inom en kategori som skaparen väljer — ett verktyg byggt för både portföljer och marknadsplatser.</p></div></div></section><div class=\"section-group-divider reveal-fade\"><h3 class=\"section-group-divider-title\">För administratörer</h3></div><section id=\"Medlemmar\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/members-mcgill-library-eMw-fVXNpME-unsplash.jpg);--accent:#F45D9E;--accent-soft:#FFE1EF;--accent-deep:#123324\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#F45D9E\"><div class=\"story-index\" style=\"--accent-transparent:#F45D9Eb3\">06</div><h2 class=\"story-title\">Medlemmar</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(51.42857142857143, 70%, 82%, 1)\">Hantera medlemmar</span><span class=\"tag-chip\" style=\"background:hsla(102.85714285714286, 70%, 82%, 1)\">Gemenskap</span><span class=\"tag-chip\" style=\"background:hsla(154.28571428571428, 70%, 82%, 1)\">Medlemskap</span><span class=\"tag-chip\" style=\"background:hsla(205.71428571428572, 70%, 82%, 1)\">Verifiering</span><span class=\"tag-chip\" style=\"background:hsla(257.14285714285717, 70%, 82%, 1)\">Roller och behörigheter</span><span class=\"tag-chip\" style=\"background:hsla(308.57142857142856, 70%, 82%, 1)\">Följare</span></div><img class=\"story-image\" src=\"/members.png\" alt=\"Medlemmar\"/><p class=\"story-text\">Administratörer kan hitta, filtrera och hantera varje medlem i organisationen från ett och samma ställe: verifiera eller avverifiera personer för specifika förmågor, som att publicera aktiviteter i kalendern eller starta en grupp.</p></div></div></section><section id=\"Komponerbara sidor\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/info-british-library-b8vYa2-83pw-unsplash.jpg);--accent:#2EC4B6;--accent-soft:#DBF6F3;--accent-deep:#3D1810\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#2EC4B6\"><div class=\"story-index\" style=\"--accent-transparent:#2EC4B6b3\">07</div><h2 class=\"story-title\">Komponerbara sidor</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(60, 70%, 82%, 1)\">Dra och släpp</span><span class=\"tag-chip\" style=\"background:hsla(120, 70%, 82%, 1)\">Landningssidor</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Kampanjer</span><span class=\"tag-chip\" style=\"background:hsla(240, 70%, 82%, 1)\">Statiska sidor</span><span class=\"tag-chip\" style=\"background:hsla(300, 70%, 82%, 1)\">Utan kod</span></div><p class=\"story-text\">Bygg fritt en landningssida, en kampanjsida, eller vilken statisk sida ditt samhälle behöver — med dra-och-släpp-block för text, bilder och layout, helt utan kod. Det som en gång var Cocosos enklaste CMS är nu en riktig sidbyggare.</p></div></div></section><section id=\"Adminpanel\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/intro-mcgill-library-rxZLty9pnh4-unsplash.jpg);--accent:#D7263D;--accent-soft:#FBDEE1;--accent-deep:#0E3B36\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#D7263D\"><div class=\"story-index\" style=\"--accent-transparent:#D7263Db3\">08</div><h2 class=\"story-title\">Adminpanel</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(60, 70%, 82%, 1)\">Organisationsinställningar</span><span class=\"tag-chip\" style=\"background:hsla(120, 70%, 82%, 1)\">Varumärke</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Meny och navigering</span><span class=\"tag-chip\" style=\"background:hsla(240, 70%, 82%, 1)\">Header och footer</span><span class=\"tag-chip\" style=\"background:hsla(300, 70%, 82%, 1)\">Inställningar</span></div><p class=\"story-text\">En dedikerad adminpanel för att sätta upp din organisation från grunden: namn, logotyp, kontaktuppgifter, och varje inställning som formar hur ditt samhälle presenterar sig — helt utan kod.</p></div></div></section><section id=\"Designinställningar\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/activities-mcgill-library-1Rbv8ubJix0-unsplash.jpg);--accent:#F2B705;--accent-soft:#FFF6D9;--accent-deep:#1B1642\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#F2B705\"><div class=\"story-index\" style=\"--accent-transparent:#F2B705b3\">09</div><h2 class=\"story-title\">Designinställningar</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(72, 70%, 82%, 1)\">Färger</span><span class=\"tag-chip\" style=\"background:hsla(144, 70%, 82%, 1)\">Hörnradie</span><span class=\"tag-chip\" style=\"background:hsla(216, 70%, 82%, 1)\">Bakgrunder</span><span class=\"tag-chip\" style=\"background:hsla(288, 70%, 82%, 1)\">Utseende och känsla</span></div><p class=\"story-text\">Ge ditt samhälles webbplats en egen visuell identitet: välj dina färger, justera hörnradie, sätt en bakgrund — gör den tydligt din egen, utan att röra en enda rad CSS.</p></div></div></section><section id=\"Nyhetsbrev och e-post\" class=\"story-section\"><div class=\"story-bg\" style=\"background-image:url(/slider/resources-mcgill-library---DJjEqekIM-unsplash.jpg);--accent:#1B7F9E;--accent-soft:#DAF0F6;--accent-deep:#4A1E12\"></div><div class=\"story-card-wrap\"><div class=\"story-card\" style=\"--accent:#1B7F9E\"><div class=\"story-index\" style=\"--accent-transparent:#1B7F9Eb3\">10</div><h2 class=\"story-title\">Nyhetsbrev och e-post</h2><div class=\"tag-row\"><span class=\"tag-chip\" style=\"background:hsla(90, 70%, 82%, 1)\">E-postnyhetsbrev</span><span class=\"tag-chip\" style=\"background:hsla(180, 70%, 82%, 1)\">Automatiska e-postmeddelanden</span><span class=\"tag-chip\" style=\"background:hsla(270, 70%, 82%, 1)\">Medlemskommunikation</span></div><p class=\"story-text\">Nå varje medlem direkt med ett e-postnyhetsbrev — inget separat verktyg för e-postlistor behövs. Skriv en gång, skicka till hela ditt samhälle, och håll folk uppdaterade utan att förlita dig på ett socialt flöde.</p></div></div></section><footer class=\"site-footer\"><div class=\"footer-rainbow\"></div><div class=\"footer-inner\"><div class=\"footer-brand\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/><p>Öppen källkodsprogramvara för federationer av samhällen, kooperativ och gräsrotsgrupper — en offentlig webbplats och ett intranät, alltid på dina egna villkor.</p></div><div class=\"footer-col\"><p class=\"footer-col-title\">Utforska</p><a href=\"/sv\">Hem</a><a href=\"/sv/features\">Funktioner</a><a href=\"/sv/clients\">Exempel</a><a href=\"/sv/contact\">Kontakt</a></div><div class=\"footer-col\"><p class=\"footer-col-title\">Projekt</p><a href=\"https://github.com/eminx/cocoso\" target=\"_blank\" rel=\"noopener noreferrer\">Källkod</a><a href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Live-demo</a><p class=\"footer-license\">Fri och öppen källkod, licensierad under GNU GPLv3.</p></div></div><div class=\"footer-bottom\"><p>© 2026 Cocoso. Byggt för autonoma samhällen överallt.</p></div></footer></div></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"__lang\":\"sv\",\"__namespaces\":{\"common\":{\"meta\":{\"title\":\"Cocoso — Programvara för samhällssamarbete\",\"description\":\"Programvara med öppen källkod för federationer av samhällen, kooperativ och gräsrotsgrupper — kalender, resurser, evenemang, grupper, komponerbara sidor och mer, alltid på dina egna villkor.\"},\"brand\":{\"title\":\"COCOSO\",\"slogan\":\"Programvara för samhällssamarbete\"},\"nav\":{\"home\":\"Hem\",\"features\":\"Funktioner\",\"examples\":\"Exempel\",\"contact\":\"Kontakt\",\"sourceCode\":\"Källkod\",\"getStarted\":\"Utforska funktioner\",\"demo\":\"Live-demo\",\"language\":\"Språk\"},\"home\":{\"leadTitle\":\"Programvara för autonoma, federerade samhällen\",\"lead\":[\"Cocoso är programvara med öppen källkod för autonoma samhällen: en offentlig webbplats och ett intranät, på ett och samma ställe. Den är byggd för kooperativ, ekobyar, konstnärsdrivna utrymmen, festivaler och gräsrotsgrupper som vill driva sin egen verksamhet, på sina egna villkor.\",\"En inloggning. Många samhällen. Din data, alltid din.\"],\"leadTags\":[\"Onlineplattformar\",\"Kooperativ\",\"Icke-vinstdrivande\",\"Festivaler\",\"Konferenser\",\"Konstnärsdrivna utrymmen\",\"Ekobyar\",\"Samhällen\",\"Campingplatser\"],\"tripleTitle\":\"Mer än en webbplats\",\"tripleTags\":[\"Offentlig webbplats\",\"Communitynätverk\",\"Produktivitetsverktyg\"],\"triple\":[\"Cocoso är en offentlig webbplats, så att världen kan se vilka ni är, vad ni gör och vad som är på gång — ingen separat webbplats behövs.\",\"Det är också ett privat communitynätverk: medlemmar kan följa aktiviteter, dela uppdateringar och hålla varandra uppdaterade — utan annonser, algoritmer eller spårning. Sociala medier, minus utvinningen.\",\"Och det är ett riktigt produktivitetsverktyg för den praktiska sidan av att driva ett samhälle: en delad kalender, resursbokningar, OSA och adminverktyg som håller alla på samma sida.\"],\"federationTitle\":\"Federation\",\"federationTags\":[\"Nätverk av samhällen\",\"Portal\",\"Gemensam upptäckt\",\"Autonom som standard\"],\"federation\":[\"Cocoso är inte begränsat till en enda grupp. Ett driftsatt system kan vara värd för en hel federation av oberoende samhällen — vart och ett med sin egen domän, sin egen känsla och sina egna medlemmar — samtidigt som de är synliga som en del av ett större nätverk.\",\"En federation kan utse ett samhälle till sin Portal: en gemensam ingång där besökare kan bläddra bland alla anslutna samhällen, filtrera aktiviteter över hela nätverket och hitta rätt. Alla behåller sin självständighet; nätverket behåller sin sammanhållning.\",\"Det passar naturligt för en rörelse som består av många autonoma grupper — som ett nätverk av ekobyar, kooperativ eller gräsrotsinitiativ som vill stå tillsammans utan att ge upp det lokala självstyret.\"],\"accountsTitle\":\"En inloggning, många samhällen\",\"accountsTags\":[\"Globala konton\",\"Roller per samhälle\",\"Portabel identitet\",\"Verifierat medlemskap\"],\"accounts\":[\"Varje person har ett enda Cocoso-konto, oavsett var deras samhällen finns. Gå med i ett kooperativ här, en festival där, en ekoby någon annanstans — en identitet följer med dig, medan din roll och synlighet ställs in separat på varje plats.\",\"Administratörer verifierar medlemmar samhälle för samhälle och ger rätt att publicera aktiviteter, driva en grupp eller hantera resurser lokalt — utan att någonsin behöva röra ett annat samhälles inställningar eller medlemmar.\"],\"dataTitle\":\"Din egen data\",\"dataTags\":[\"Ingen spårning\",\"Inga tredje parter\",\"Datasuveränitet\",\"Integritet från grunden\"],\"data\":[\"Cocoso har inga verktyg för att spionera på användare eller spåra deras data. Ingen information delas med någon tredjepartstjänst eller annonsör — datan tillhör det samhälle som skapade den, punkt.\",\"Varje medlem avgör hur mycket av sin egen information de vill dela, och varje samhälle avgör hur mycket av sin aktivitet som ska synas i den bredare federationen. Du driver dina projekt, och din data, på dina egna villkor.\"],\"openSourceTitle\":\"Öppen källkod\",\"openSourceTags\":[\"Kan självhostas\",\"Samhällsdrivet\",\"Transparent\",\"Fri programvara\"],\"openSource\":[\"Cocoso är fri, öppen programvara utvecklad helt i öppenhet — du kan läsa varje rad kod, köra den på din egen server, eller lita på en värd du själv väljer. Ingen inlåsning, ingen svart låda.\",\"Den formas av samhällena som använder den: konstnärer, kooperativ, alternativa valutaprojekt och samskapande platser som har gett verkliga behov tillbaka till projektet sedan dess tidigaste dagar.\"],\"ctaTitle\":\"Se allt Cocoso kan göra\",\"ctaBody\":\"Från kalendern till adminpanelen — varje funktion är byggd för att användas av ett samhälle, inte en webbmaster. Utforska vad som finns.\",\"ctaButton\":\"Utforska funktioner\",\"ctaSecondary\":\"Eller säg bara hej\"},\"features\":{\"pageTitle\":\"Funktioner\",\"pageLead\":\"Cocoso i detalj — varje verktyg ditt samhälle kan använda, och hur det fungerar.\",\"groupCommunityTitle\":\"För ditt samhälle\",\"groupAdminTitle\":\"För administratörer\",\"activityTitle\":\"Aktiviteter\",\"activityTags\":[\"Offentliga evenemang\",\"OSA\",\"Pågående arbete\",\"Föreställningar\",\"Utställningar\",\"Konserter\",\"Konferenser\",\"Internt\",\"Bokningar\"],\"activities\":[\"Den tidigaste versionen av Cocoso byggdes för en artistdriven dansteater och ett samlärande utrymme, som är värd för flera offentliga scenframträdanden för förregistrerad publik. Hantering och publicering av anpassningsbara och återkommande evenemang kräver flera olika funktioner, OSA bland dem. Registreringar kommuniceras till gästerna via e-post, och evenemangsadministratörer kan verifiera ankomster vid dörren.\",\"Man kan skapa, redigera och ta bort innehåll med en bild, titel, beskrivning och ytterligare information, samt en uppsättning tillfällen med valfritt flera datum och tider — så administratörer behöver aldrig skapa en ny post för varje enskilt tillfälle.\"],\"resourceTitle\":\"Resurser\",\"resourceTags\":[\"Resursdelning\",\"Förvaltning av allmänningar\"],\"resources\":[\"Cocoso möjliggör planering och överblick över resursdelningsprocesser i god tid. Varje gång en verifierad användare gör anspråk på en fysisk resurs eller bokar ett utrymme delas den informationen med medlemmar i kollektivet genom kalendern.\",\"Det finns inga kalenderinbjudningar. Vi tror att maskiner ska hjälpa oss att underlätta vår egen kommunikation och delning — inte agera åt oss. Cocosos kalender är huvudfasaden för samhällets evenemang och resursdelning, så att vi fortsätter prata med varandra, på samma sätt som vi befriar våra e-postbrevlådor från datatrassel.\"],\"calendarTitle\":\"Kalender\",\"calendarTags\":[\"Schemaläggning\",\"Dagordning\",\"Delning av allmänningar\",\"Programmering av aktiviteter\",\"Bokning av resurser\"],\"calendar\":[\"Cocosos webbkalender kan visa månads-, vecko- eller dagshändelser och resursuppdateringar, och användare kan navigera mellan dessa tidsramar med ett enda tryck. Varje post kan motsvara en resursanvändningsaktivitet eller en samhällshändelse.\",\"Varje post kan tilldelas en kategori — en bokad resurs, eller en typ av aktivitet som yoga — användbart för både offentliga aktivitetslistor och interna eller privata bokningar. Precis som alla funktioner i Cocoso är den avsiktligt abstrakt nog för att passa väldigt olika användningsfall.\"],\"groupTitle\":\"Grupper\",\"groupTags\":[\"Studiegrupper\",\"Skolor\",\"Samskapande\",\"Återkommande händelser\",\"Delade dokument\",\"Medlemsaktiviteter\"],\"groups\":[\"En Grupp är ett koncept, och en uppsättning konceptuellt drivna aktiviteter som drivs av en uppsättning människor — virtuellt eller på plats. Under en grupp kan medlemmar genomföra samarbetsaktiviteter med alla praktiska detaljer, grundläggande information och datum dokumenterade på en sida.\",\"Grupper gör det möjligt att hantera utbildning, sociala eller inlärningsaktiviteter — återkommande yogapass, skolterminer, eller vilken typ av samskapande och ständigt utvecklande process som helst. Administratörer startar en med en bild och lite text, och ett enkelt forum, dokumentlista, medlemslista och uppsättning datum är klart på en sida.\",\"Det är i grunden verktygslådan för att driva en skola, ett återkommande pass, eller en samarbetsaktivitet av vilket slag som helst.\"],\"workTitle\":\"Verk\",\"workTags\":[\"Portfölj\",\"Marknadsplats\",\"Dokumentation\",\"Presentation\"],\"works\":[\"Ett Verk är en visuell, eller audiovisuell, skapelse av en konstnär, forskare, designer, hantverkare eller återförsäljare, presenterad för samhället. Detaljer, bilder, ljudfiler och videor kan delas inom en kategori som skaparen väljer — ett verktyg byggt för både portföljer och marknadsplatser.\",\"Ett verk kan också sparas privat för internt bruk och dokumentation. Det är byggt för att låta konstnärer och hantverkare publicera och kommunicera vad de gör med resten av världen, samt behålla ett register för egen referens.\"],\"memberTitle\":\"Medlemmar\",\"memberTags\":[\"Hantera medlemmar\",\"Gemenskap\",\"Medlemskap\",\"Verifiering\",\"Roller och behörigheter\",\"Följare\"],\"members\":[\"Administratörer kan hitta, filtrera och hantera varje medlem i organisationen från ett och samma ställe: verifiera eller avverifiera personer för specifika förmågor, som att publicera aktiviteter i kalendern eller starta en grupp.\",\"Om du driver en yogastudio har du till exempel både lärare och elever på samma plattform — verifiera dina lärare så de kan skapa sina egna aktiviteter, medan eleverna helt enkelt kan delta och anmäla sig.\",\"Behörigheter fördelas meningsfullt över samhället, och varje användare skapar och hanterar sitt eget konto. Lösenord krypteras automatiskt, så systemadministratörer varken kan läsa eller spåra dem.\"],\"pagesTitle\":\"Komponerbara sidor\",\"pagesTags\":[\"Dra och släpp\",\"Landningssidor\",\"Kampanjer\",\"Statiska sidor\",\"Utan kod\"],\"pages\":[\"Bygg fritt en landningssida, en kampanjsida, eller vilken statisk sida ditt samhälle behöver — med dra-och-släpp-block för text, bilder och layout, helt utan kod. Det som en gång var Cocosos enklaste CMS är nu en riktig sidbyggare.\",\"Varje sida blir automatiskt en del av din navigering. Använd den för en Om oss-sida, en uppsättning villkor, en enskild kampanj, eller en helt ny del av din webbplats — fritt komponerad, publicerad direkt.\"],\"adminTitle\":\"Adminpanel\",\"adminTags\":[\"Organisationsinställningar\",\"Varumärke\",\"Meny och navigering\",\"Header och footer\",\"Inställningar\"],\"admin\":[\"En dedikerad adminpanel för att sätta upp din organisation från grunden: namn, logotyp, kontaktuppgifter, och varje inställning som formar hur ditt samhälle presenterar sig — helt utan kod.\",\"Skräddarsy din meny, header och footer, och bestäm exakt vad besökare ser först. Det är kontrollrummet bakom varje Cocoso-samhälle, byggt för administratörer, inte utvecklare.\"],\"designTitle\":\"Designinställningar\",\"designTags\":[\"Färger\",\"Hörnradie\",\"Bakgrunder\",\"Utseende och känsla\"],\"design\":[\"Ge ditt samhälles webbplats en egen visuell identitet: välj dina färger, justera hörnradie, sätt en bakgrund — gör den tydligt din egen, utan att röra en enda rad CSS.\",\"Designinställningar gäller över hela din webbplats på en gång, så att ditt samhälles närvaro förblir sammanhållen när det växer, från startsidan till kalendern till varje komponerbar sida.\"],\"newsletterTitle\":\"Nyhetsbrev och e-post\",\"newsletterTags\":[\"E-postnyhetsbrev\",\"Automatiska e-postmeddelanden\",\"Medlemskommunikation\"],\"newsletter\":[\"Nå varje medlem direkt med ett e-postnyhetsbrev — inget separat verktyg för e-postlistor behövs. Skriv en gång, skicka till hela ditt samhälle, och håll folk uppdaterade utan att förlita dig på ett socialt flöde.\",\"Automatiska e-postmeddelanden sköter de rutinmässiga momenten åt dig: bekräftelser av registrering, verifiering av anmälningar och andra medlemsnotiser skickas av sig själva, så administratörer kan fokusera på samhället istället för inkorgen.\"]},\"clients\":{\"pageTitle\":\"Exempel på användning\",\"pageLead\":\"Verkliga samhällen, studior och konstnärer som redan kör på Cocoso — federerade nätverk, delade arbetsytor, evenemangskalendrar och personliga portföljer, alla anpassade efter behov.\",\"samarbetetTitle\":\"Samarbetet\",\"samarbetetTags\":[\"Sverige\",\"Federation\",\"Konstnärer \\u0026 Kulturplatser\"],\"samarbetet\":[\"Samarbetet är en federation av oberoende samhällen runt om i Sverige — konstnärer, konstplatser, trädgårdar, verkstäder och människor, sammankopplade i ett gemensamt nätverk.\",\"Medlemmarna delar scener, trädgårdar, verkstäder och mötesplatser, driver egna program och butiker, och förblir självständiga samtidigt som de drar nytta av en gemensam ingång till hela ekosystemet.\"],\"samarbetetLinkLabel\":\"Besök samarbetet.org\",\"kkvTitle\":\"KKV Stockholm\",\"kkvTags\":[\"Resursbokning\",\"200+ resurser\",\"400+ medlemmar\"],\"kkv\":[\"KKV Stockholm — Konstnärernas Kollektivverkstad — är en gemensam verkstad för yrkesverksamma konstnärer, som ger över 400 medlemmar delad tillgång till mer än 200 utrustningar och verkstadsytor.\",\"Medlemmarna bokar resurser via Cocosos kalender, publicerar sina egna portföljer och offentliga evenemang, och hittar varandra på en gemensam medlemssida — en stor, livlig verkstad som drivs smidigt på en plattform.\"],\"kkvLinkLabel\":\"Besök stockholm.kkv.nu\",\"hojdenTitle\":\"höjden\",\"hojdenTags\":[\"Konstnärsdriven plats\",\"Resursbokning\",\"Portföljer\"],\"hojden\":[\"höjden är en konstnärsdriven plats i Stockholm — studior, en scen, ett dansgolv, ett galleri och ett kök, driven kollektivt av kooperativet Släktet sedan 2018.\",\"Precis som KKV använder höjden Cocoso för att hantera bokningar av sina delade ytor och utrustning, tillsammans med medlemsportföljer och ett offentligt program av workshops, föreställningar och föreläsningar.\"],\"hojdenLinkLabel\":\"Besök hojden.house\",\"gerlesborgTitle\":\"Gerlesborgs Kulturhus\",\"gerlesborgTags\":[\"Kulturhus\",\"Offentliga evenemang\",\"Kalender\"],\"gerlesborg\":[\"Gerlesborgs kulturhus är ett kulturhus i Hamburgsund, som är värd för utställningar, konserter, workshops och en litteraturfestival för samhället runt omkring.\",\"Det använder Cocoso enkelt och effektivt för att publicera sitt offentliga program — varje utställning, konsert och kurs dyker upp direkt i kalendern, utan något separat evenemangsverktyg.\"],\"gerlesborgLinkLabel\":\"Besök gerlesborgskulturhus.se\",\"minaTitle\":\"Mîna Kocailik\",\"minaTags\":[\"Portfölj\",\"Oberoende konstnär\"],\"mina\":[\"Mîna Kocailik är en oberoende konstnär som helt enkelt använder Cocoso för att publicera sin portfölj: en ren, självstyrd presentation av hennes arbete, utan något extra att underhålla.\",\"Det är den minsta möjliga användningen av Cocoso — ett bevis på att samma plattform som betjänar federationer med hundratals människor fungerar lika bra för en enskild konstnärlig verksamhet.\"],\"minaLinkLabel\":\"Besök hennes portfölj\"},\"credits\":{\"title\":\"Krediter\",\"first\":\"Utvecklat i ett fantastiskt samarbete med\",\"second\":\"Stöds av\"},\"contact\":{\"title\":\"Kontakt\",\"heading\":\"Vi kan arbeta tillsammans\",\"body\":\"Har du ett projekt som du kan ha användning av Cocoso till? Eller vill du bara säga hej och bli vänner? Skicka ett meddelande här, så återkommer vi till dig!\",\"email\":\"Din e-postadress\",\"subject\":\"Ämne\",\"message\":\"Meddelande\",\"send\":\"Skicka\"},\"footer\":{\"tagline\":\"Öppen källkodsprogramvara för federationer av samhällen, kooperativ och gräsrotsgrupper — en offentlig webbplats och ett intranät, alltid på dina egna villkor.\",\"exploreTitle\":\"Utforska\",\"projectTitle\":\"Projekt\",\"license\":\"Fri och öppen källkod, licensierad under GNU GPLv3.\",\"bottom\":\"© {{year}} Cocoso. Byggt för autonoma samhällen överallt.\"},\"source\":\"Källa\"}}},\"__N_SSG\":true},\"page\":\"/features\",\"query\":{},\"buildId\":\"Ih6amJPyctjAuesHQ7FZZ\",\"isFallback\":false,\"gsp\":true,\"locale\":\"sv\",\"locales\":[\"en\",\"sv\",\"tr\",\"de\",\"es\",\"pt-PT\",\"pt-BR\"],\"defaultLocale\":\"en\",\"scriptLoader\":[]}</script></body></html>","json":{"pageProps":{"__lang":"sv","__namespaces":{"common":{"meta":{"title":"Cocoso — Programvara för samhällssamarbete","description":"Programvara med öppen källkod för federationer av samhällen, kooperativ och gräsrotsgrupper — kalender, resurser, evenemang, grupper, komponerbara sidor och mer, alltid på dina egna villkor."},"brand":{"title":"COCOSO","slogan":"Programvara för samhällssamarbete"},"nav":{"home":"Hem","features":"Funktioner","examples":"Exempel","contact":"Kontakt","sourceCode":"Källkod","getStarted":"Utforska funktioner","demo":"Live-demo","language":"Språk"},"home":{"leadTitle":"Programvara för autonoma, federerade samhällen","lead":["Cocoso är programvara med öppen källkod för autonoma samhällen: en offentlig webbplats och ett intranät, på ett och samma ställe. Den är byggd för kooperativ, ekobyar, konstnärsdrivna utrymmen, festivaler och gräsrotsgrupper som vill driva sin egen verksamhet, på sina egna villkor.","En inloggning. Många samhällen. Din data, alltid din."],"leadTags":["Onlineplattformar","Kooperativ","Icke-vinstdrivande","Festivaler","Konferenser","Konstnärsdrivna utrymmen","Ekobyar","Samhällen","Campingplatser"],"tripleTitle":"Mer än en webbplats","tripleTags":["Offentlig webbplats","Communitynätverk","Produktivitetsverktyg"],"triple":["Cocoso är en offentlig webbplats, så att världen kan se vilka ni är, vad ni gör och vad som är på gång — ingen separat webbplats behövs.","Det är också ett privat communitynätverk: medlemmar kan följa aktiviteter, dela uppdateringar och hålla varandra uppdaterade — utan annonser, algoritmer eller spårning. Sociala medier, minus utvinningen.","Och det är ett riktigt produktivitetsverktyg för den praktiska sidan av att driva ett samhälle: en delad kalender, resursbokningar, OSA och adminverktyg som håller alla på samma sida."],"federationTitle":"Federation","federationTags":["Nätverk av samhällen","Portal","Gemensam upptäckt","Autonom som standard"],"federation":["Cocoso är inte begränsat till en enda grupp. Ett driftsatt system kan vara värd för en hel federation av oberoende samhällen — vart och ett med sin egen domän, sin egen känsla och sina egna medlemmar — samtidigt som de är synliga som en del av ett större nätverk.","En federation kan utse ett samhälle till sin Portal: en gemensam ingång där besökare kan bläddra bland alla anslutna samhällen, filtrera aktiviteter över hela nätverket och hitta rätt. Alla behåller sin självständighet; nätverket behåller sin sammanhållning.","Det passar naturligt för en rörelse som består av många autonoma grupper — som ett nätverk av ekobyar, kooperativ eller gräsrotsinitiativ som vill stå tillsammans utan att ge upp det lokala självstyret."],"accountsTitle":"En inloggning, många samhällen","accountsTags":["Globala konton","Roller per samhälle","Portabel identitet","Verifierat medlemskap"],"accounts":["Varje person har ett enda Cocoso-konto, oavsett var deras samhällen finns. Gå med i ett kooperativ här, en festival där, en ekoby någon annanstans — en identitet följer med dig, medan din roll och synlighet ställs in separat på varje plats.","Administratörer verifierar medlemmar samhälle för samhälle och ger rätt att publicera aktiviteter, driva en grupp eller hantera resurser lokalt — utan att någonsin behöva röra ett annat samhälles inställningar eller medlemmar."],"dataTitle":"Din egen data","dataTags":["Ingen spårning","Inga tredje parter","Datasuveränitet","Integritet från grunden"],"data":["Cocoso har inga verktyg för att spionera på användare eller spåra deras data. Ingen information delas med någon tredjepartstjänst eller annonsör — datan tillhör det samhälle som skapade den, punkt.","Varje medlem avgör hur mycket av sin egen information de vill dela, och varje samhälle avgör hur mycket av sin aktivitet som ska synas i den bredare federationen. Du driver dina projekt, och din data, på dina egna villkor."],"openSourceTitle":"Öppen källkod","openSourceTags":["Kan självhostas","Samhällsdrivet","Transparent","Fri programvara"],"openSource":["Cocoso är fri, öppen programvara utvecklad helt i öppenhet — du kan läsa varje rad kod, köra den på din egen server, eller lita på en värd du själv väljer. Ingen inlåsning, ingen svart låda.","Den formas av samhällena som använder den: konstnärer, kooperativ, alternativa valutaprojekt och samskapande platser som har gett verkliga behov tillbaka till projektet sedan dess tidigaste dagar."],"ctaTitle":"Se allt Cocoso kan göra","ctaBody":"Från kalendern till adminpanelen — varje funktion är byggd för att användas av ett samhälle, inte en webbmaster. Utforska vad som finns.","ctaButton":"Utforska funktioner","ctaSecondary":"Eller säg bara hej"},"features":{"pageTitle":"Funktioner","pageLead":"Cocoso i detalj — varje verktyg ditt samhälle kan använda, och hur det fungerar.","groupCommunityTitle":"För ditt samhälle","groupAdminTitle":"För administratörer","activityTitle":"Aktiviteter","activityTags":["Offentliga evenemang","OSA","Pågående arbete","Föreställningar","Utställningar","Konserter","Konferenser","Internt","Bokningar"],"activities":["Den tidigaste versionen av Cocoso byggdes för en artistdriven dansteater och ett samlärande utrymme, som är värd för flera offentliga scenframträdanden för förregistrerad publik. Hantering och publicering av anpassningsbara och återkommande evenemang kräver flera olika funktioner, OSA bland dem. Registreringar kommuniceras till gästerna via e-post, och evenemangsadministratörer kan verifiera ankomster vid dörren.","Man kan skapa, redigera och ta bort innehåll med en bild, titel, beskrivning och ytterligare information, samt en uppsättning tillfällen med valfritt flera datum och tider — så administratörer behöver aldrig skapa en ny post för varje enskilt tillfälle."],"resourceTitle":"Resurser","resourceTags":["Resursdelning","Förvaltning av allmänningar"],"resources":["Cocoso möjliggör planering och överblick över resursdelningsprocesser i god tid. Varje gång en verifierad användare gör anspråk på en fysisk resurs eller bokar ett utrymme delas den informationen med medlemmar i kollektivet genom kalendern.","Det finns inga kalenderinbjudningar. Vi tror att maskiner ska hjälpa oss att underlätta vår egen kommunikation och delning — inte agera åt oss. Cocosos kalender är huvudfasaden för samhällets evenemang och resursdelning, så att vi fortsätter prata med varandra, på samma sätt som vi befriar våra e-postbrevlådor från datatrassel."],"calendarTitle":"Kalender","calendarTags":["Schemaläggning","Dagordning","Delning av allmänningar","Programmering av aktiviteter","Bokning av resurser"],"calendar":["Cocosos webbkalender kan visa månads-, vecko- eller dagshändelser och resursuppdateringar, och användare kan navigera mellan dessa tidsramar med ett enda tryck. Varje post kan motsvara en resursanvändningsaktivitet eller en samhällshändelse.","Varje post kan tilldelas en kategori — en bokad resurs, eller en typ av aktivitet som yoga — användbart för både offentliga aktivitetslistor och interna eller privata bokningar. Precis som alla funktioner i Cocoso är den avsiktligt abstrakt nog för att passa väldigt olika användningsfall."],"groupTitle":"Grupper","groupTags":["Studiegrupper","Skolor","Samskapande","Återkommande händelser","Delade dokument","Medlemsaktiviteter"],"groups":["En Grupp är ett koncept, och en uppsättning konceptuellt drivna aktiviteter som drivs av en uppsättning människor — virtuellt eller på plats. Under en grupp kan medlemmar genomföra samarbetsaktiviteter med alla praktiska detaljer, grundläggande information och datum dokumenterade på en sida.","Grupper gör det möjligt att hantera utbildning, sociala eller inlärningsaktiviteter — återkommande yogapass, skolterminer, eller vilken typ av samskapande och ständigt utvecklande process som helst. Administratörer startar en med en bild och lite text, och ett enkelt forum, dokumentlista, medlemslista och uppsättning datum är klart på en sida.","Det är i grunden verktygslådan för att driva en skola, ett återkommande pass, eller en samarbetsaktivitet av vilket slag som helst."],"workTitle":"Verk","workTags":["Portfölj","Marknadsplats","Dokumentation","Presentation"],"works":["Ett Verk är en visuell, eller audiovisuell, skapelse av en konstnär, forskare, designer, hantverkare eller återförsäljare, presenterad för samhället. Detaljer, bilder, ljudfiler och videor kan delas inom en kategori som skaparen väljer — ett verktyg byggt för både portföljer och marknadsplatser.","Ett verk kan också sparas privat för internt bruk och dokumentation. Det är byggt för att låta konstnärer och hantverkare publicera och kommunicera vad de gör med resten av världen, samt behålla ett register för egen referens."],"memberTitle":"Medlemmar","memberTags":["Hantera medlemmar","Gemenskap","Medlemskap","Verifiering","Roller och behörigheter","Följare"],"members":["Administratörer kan hitta, filtrera och hantera varje medlem i organisationen från ett och samma ställe: verifiera eller avverifiera personer för specifika förmågor, som att publicera aktiviteter i kalendern eller starta en grupp.","Om du driver en yogastudio har du till exempel både lärare och elever på samma plattform — verifiera dina lärare så de kan skapa sina egna aktiviteter, medan eleverna helt enkelt kan delta och anmäla sig.","Behörigheter fördelas meningsfullt över samhället, och varje användare skapar och hanterar sitt eget konto. Lösenord krypteras automatiskt, så systemadministratörer varken kan läsa eller spåra dem."],"pagesTitle":"Komponerbara sidor","pagesTags":["Dra och släpp","Landningssidor","Kampanjer","Statiska sidor","Utan kod"],"pages":["Bygg fritt en landningssida, en kampanjsida, eller vilken statisk sida ditt samhälle behöver — med dra-och-släpp-block för text, bilder och layout, helt utan kod. Det som en gång var Cocosos enklaste CMS är nu en riktig sidbyggare.","Varje sida blir automatiskt en del av din navigering. Använd den för en Om oss-sida, en uppsättning villkor, en enskild kampanj, eller en helt ny del av din webbplats — fritt komponerad, publicerad direkt."],"adminTitle":"Adminpanel","adminTags":["Organisationsinställningar","Varumärke","Meny och navigering","Header och footer","Inställningar"],"admin":["En dedikerad adminpanel för att sätta upp din organisation från grunden: namn, logotyp, kontaktuppgifter, och varje inställning som formar hur ditt samhälle presenterar sig — helt utan kod.","Skräddarsy din meny, header och footer, och bestäm exakt vad besökare ser först. Det är kontrollrummet bakom varje Cocoso-samhälle, byggt för administratörer, inte utvecklare."],"designTitle":"Designinställningar","designTags":["Färger","Hörnradie","Bakgrunder","Utseende och känsla"],"design":["Ge ditt samhälles webbplats en egen visuell identitet: välj dina färger, justera hörnradie, sätt en bakgrund — gör den tydligt din egen, utan att röra en enda rad CSS.","Designinställningar gäller över hela din webbplats på en gång, så att ditt samhälles närvaro förblir sammanhållen när det växer, från startsidan till kalendern till varje komponerbar sida."],"newsletterTitle":"Nyhetsbrev och e-post","newsletterTags":["E-postnyhetsbrev","Automatiska e-postmeddelanden","Medlemskommunikation"],"newsletter":["Nå varje medlem direkt med ett e-postnyhetsbrev — inget separat verktyg för e-postlistor behövs. Skriv en gång, skicka till hela ditt samhälle, och håll folk uppdaterade utan att förlita dig på ett socialt flöde.","Automatiska e-postmeddelanden sköter de rutinmässiga momenten åt dig: bekräftelser av registrering, verifiering av anmälningar och andra medlemsnotiser skickas av sig själva, så administratörer kan fokusera på samhället istället för inkorgen."]},"clients":{"pageTitle":"Exempel på användning","pageLead":"Verkliga samhällen, studior och konstnärer som redan kör på Cocoso — federerade nätverk, delade arbetsytor, evenemangskalendrar och personliga portföljer, alla anpassade efter behov.","samarbetetTitle":"Samarbetet","samarbetetTags":["Sverige","Federation","Konstnärer & Kulturplatser"],"samarbetet":["Samarbetet är en federation av oberoende samhällen runt om i Sverige — konstnärer, konstplatser, trädgårdar, verkstäder och människor, sammankopplade i ett gemensamt nätverk.","Medlemmarna delar scener, trädgårdar, verkstäder och mötesplatser, driver egna program och butiker, och förblir självständiga samtidigt som de drar nytta av en gemensam ingång till hela ekosystemet."],"samarbetetLinkLabel":"Besök samarbetet.org","kkvTitle":"KKV Stockholm","kkvTags":["Resursbokning","200+ resurser","400+ medlemmar"],"kkv":["KKV Stockholm — Konstnärernas Kollektivverkstad — är en gemensam verkstad för yrkesverksamma konstnärer, som ger över 400 medlemmar delad tillgång till mer än 200 utrustningar och verkstadsytor.","Medlemmarna bokar resurser via Cocosos kalender, publicerar sina egna portföljer och offentliga evenemang, och hittar varandra på en gemensam medlemssida — en stor, livlig verkstad som drivs smidigt på en plattform."],"kkvLinkLabel":"Besök stockholm.kkv.nu","hojdenTitle":"höjden","hojdenTags":["Konstnärsdriven plats","Resursbokning","Portföljer"],"hojden":["höjden är en konstnärsdriven plats i Stockholm — studior, en scen, ett dansgolv, ett galleri och ett kök, driven kollektivt av kooperativet Släktet sedan 2018.","Precis som KKV använder höjden Cocoso för att hantera bokningar av sina delade ytor och utrustning, tillsammans med medlemsportföljer och ett offentligt program av workshops, föreställningar och föreläsningar."],"hojdenLinkLabel":"Besök hojden.house","gerlesborgTitle":"Gerlesborgs Kulturhus","gerlesborgTags":["Kulturhus","Offentliga evenemang","Kalender"],"gerlesborg":["Gerlesborgs kulturhus är ett kulturhus i Hamburgsund, som är värd för utställningar, konserter, workshops och en litteraturfestival för samhället runt omkring.","Det använder Cocoso enkelt och effektivt för att publicera sitt offentliga program — varje utställning, konsert och kurs dyker upp direkt i kalendern, utan något separat evenemangsverktyg."],"gerlesborgLinkLabel":"Besök gerlesborgskulturhus.se","minaTitle":"Mîna Kocailik","minaTags":["Portfölj","Oberoende konstnär"],"mina":["Mîna Kocailik är en oberoende konstnär som helt enkelt använder Cocoso för att publicera sin portfölj: en ren, självstyrd presentation av hennes arbete, utan något extra att underhålla.","Det är den minsta möjliga användningen av Cocoso — ett bevis på att samma plattform som betjänar federationer med hundratals människor fungerar lika bra för en enskild konstnärlig verksamhet."],"minaLinkLabel":"Besök hennes portfölj"},"credits":{"title":"Krediter","first":"Utvecklat i ett fantastiskt samarbete med","second":"Stöds av"},"contact":{"title":"Kontakt","heading":"Vi kan arbeta tillsammans","body":"Har du ett projekt som du kan ha användning av Cocoso till? Eller vill du bara säga hej och bli vänner? Skicka ett meddelande här, så återkommer vi till dig!","email":"Din e-postadress","subject":"Ämne","message":"Meddelande","send":"Skicka"},"footer":{"tagline":"Öppen källkodsprogramvara för federationer av samhällen, kooperativ och gräsrotsgrupper — en offentlig webbplats och ett intranät, alltid på dina egna villkor.","exploreTitle":"Utforska","projectTitle":"Projekt","license":"Fri och öppen källkod, licensierad under GNU GPLv3.","bottom":"© {{year}} Cocoso. Byggt för autonoma samhällen överallt."},"source":"Källa"}}},"__N_SSG":true}}