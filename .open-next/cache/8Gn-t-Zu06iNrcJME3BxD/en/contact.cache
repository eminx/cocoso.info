0.33);border-radius:4px;outline:none;border:none;width:100%;-webkit-appearance:none;max-width:100%;}/*!sc*/\n.iUKQxO::-webkit-input-placeholder{color:#AAAAAA;}/*!sc*/\n.iUKQxO::-moz-placeholder{color:#AAAAAA;}/*!sc*/\n.iUKQxO:-ms-input-placeholder{color:#AAAAAA;}/*!sc*/\n.iUKQxO::-webkit-search-decoration{-webkit-appearance:none;}/*!sc*/\n.iUKQxO::-moz-focus-inner{border:none;outline:none;}/*!sc*/\n.iUKQxO:-moz-placeholder,.iUKQxO::-moz-placeholder{opacity:1;}/*!sc*/\ndata-styled.g163[id=\"StyledTextArea-sc-17i3mwp-0\"]{content:\"iUKQxO,\"}/*!sc*/\n</style></head><body><link rel=\"preload\" as=\"image\" href=\"/cocoso-logo-small.png\"/><div id=\"__next\"><div class=\"StyledGrommet-sc-19lkkz7-0 gvavzw\"><nav class=\"top-nav--desktop\"><a class=\"top-nav-logo\" href=\"/\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"top-nav-links\"><a href=\"/\"><span class=\"top-nav-link\">Home</span></a><a href=\"/features\"><span class=\"top-nav-link\">Features</span></a><a href=\"/clients\"><span class=\"top-nav-link\">Examples</span></a><a href=\"/contact\"><span class=\"top-nav-link nav-item-active\">Contact</span></a></div><a class=\"btn-demo\" href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Live Demo</a><div class=\"nav-dropdown\"><button type=\"button\" class=\"lang-trigger\">English<svg width=\"10\" height=\"7\" viewBox=\"0 0 10 7\" fill=\"none\"><path d=\"M1 1L5 5.5L9 1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></div></nav><nav class=\"top-nav-mobile-bar\"><a class=\"top-nav-logo\" href=\"/\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"nav-dropdown\"><button type=\"button\" class=\"burger-trigger\" aria-label=\"Menu\"><svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" fill=\"none\"><path d=\"M0 1H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 8H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 15H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path></svg></button></div></nav><div class=\"simple-page\"><div class=\"simple-card\"><h1 class=\"simple-title\">We can work together</h1><p class=\"simple-body\">Do you have a project that could use Cocoso? Or do you just want to say hi and become friends? Drop us a message here, and we&#x27;ll get back to you!</p><form action=\"https://formspree.io/f/xpqrdwpl\" method=\"POST\"><div class=\"StyledBox-sc-13pk1d4-0 dASfzA FormField__FormFieldBox-sc-m9hood-0 FCiZz\"><label class=\"StyledText-sc-1sadyjn-0 iRjCgM\">Your email address</label><div class=\"StyledBox-sc-13pk1d4-0 gbHrCl FormField__FormFieldContentBox-sc-m9hood-1 fuEJvP\"><div class=\"StyledTextInput__StyledTextInputContainer-sc-1x30a0s-1 kuczHv\"><input autoComplete=\"off\" type=\"email\" class=\"StyledTextInput-sc-1x30a0s-0 dotoLH\" name=\"email\"/></div></div></div><div class=\"StyledBox-sc-13pk1d4-0 dASfzA FormField__FormFieldBox-sc-m9hood-0 FCiZz\"><label class=\"StyledText-sc-1sadyjn-0 iRjCgM\">Subject</label><div class=\"StyledBox-sc-13pk1d4-0 gbHrCl FormField__FormFieldContentBox-sc-m9hood-1 fuEJvP\"><div class=\"StyledTextInput__StyledTextInputContainer-sc-1x30a0s-1 kuczHv\"><input autoComplete=\"off\" class=\"StyledTextInput-sc-1x30a0s-0 dotoLH\" name=\"subject\"/></div></div></div><div class=\"StyledBox-sc-13pk1d4-0 dASfzA FormField__FormFieldBox-sc-m9hood-0 FCiZz\"><label class=\"StyledText-sc-1sadyjn-0 iRjCgM\">Message</label><div class=\"StyledBox-sc-13pk1d4-0 gbHrCl FormField__FormFieldContentBox-sc-m9hood-1 fuEJvP\"><textarea name=\"message\" class=\"StyledTextArea-sc-17i3mwp-0 iUKQxO\"></textarea></div></div><div class=\"StyledBox-sc-13pk1d4-0 hSapUm\"><button type=\"submit\" class=\"StyledButton-sc-323bzc-0 eRXQcD\">Send</button></div></form></div></div><footer class=\"site-footer\"><div class=\"footer-rainbow\"></div><div class=\"footer-inner\"><div class=\"footer-brand\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/><p>Open-source software for federations of communities, cooperatives and grassroots groups — a public website and a private intranet, always on your own terms.</p></div><div class=\"footer-col\"><p class=\"footer-col-title\">Explore</p><a href=\"/\">Home</a><a href=\"/features\">Features</a><a href=\"/clients\">Examples</a><a href=\"/contact\">Contact</a></div><div class=\"footer-col\"><p class=\"footer-col-title\">Project</p><a href=\"https://github.com/eminx/cocoso\" target=\"_blank\" rel=\"noopener noreferrer\">Source Code</a><a href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Live Demo</a><p class=\"footer-license\">Free and open-source, licensed under the GNU GPLv3.</p></div></div><div class=\"footer-bottom\"><p>© 2026 Cocoso. Built for autonomous communities everywhere.</p></div></footer></div></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"__lang\":\"en\",\"__namespaces\":{\"common\":{\"meta\":{\"title\":\"Cocoso — Community Cooperation Software\",\"description\":\"Open-source software for federations of communities, cooperatives and grassroots groups — calendar, resources, events, groups, composable pages and more, always on your own terms.\"},\"brand\":{\"title\":\"COCOSO\",\"slogan\":\"Community Cooperation Software\"},\"nav\":{\"home\":\"Home\",\"features\":\"Features\",\"examples\":\"Examples\",\"contact\":\"Contact\",\"sourceCode\":\"Source Code\",\"getStarted\":\"Explore Features\",\"demo\":\"Live Demo\",\"language\":\"Language\"},\"home\":{\"leadTitle\":\"Software for Autonomous, Federated Communities\",\"lead\":[\"Cocoso is open-source software for autonomous communities: a public website and a private intranet, in one place. It's built for cooperatives, ecovillages, artist-run spaces, festivals and grassroots groups who want to run their own operations, on their own terms.\",\"One login. Many communities. Your data, always yours.\"],\"leadTags\":[\"Online Platforms\",\"Cooperatives\",\"Non-Profits\",\"Festivals\",\"Conferences\",\"Artist Run Spaces\",\"Eco Villages\",\"Communities\",\"Camp Sites\"],\"tripleTitle\":\"More Than a Website\",\"tripleTags\":[\"Public Website\",\"Community Network\",\"Productivity Tool\"],\"triple\":[\"Cocoso is a public website, so the world can see who you are, what you do, and what's coming up — no separate site needed.\",\"It's also a private community network: members can follow activities, share updates and stay in the loop with each other, without ads, algorithms or tracking — social media, minus the extraction.\",\"And it's a real productivity tool for the practical side of running a community: a shared calendar, resource bookings, RSVPs and admin tools that keep everyone on the same page.\"],\"federationTitle\":\"Federation\",\"federationTags\":[\"Multi-Community Network\",\"Portal\",\"Shared Discovery\",\"Autonomous by Default\"],\"federation\":[\"Cocoso isn't limited to a single group. One deployment can host an entire federation of independent communities — each with its own domain, its own look and feel, its own members — while staying discoverable as part of a wider network.\",\"A federation can designate one community as its Portal: a shared front door where visitors browse every member community, filter activities across the whole network, and find their way in. Everyone keeps their independence; the network keeps its cohesion.\",\"It's a natural fit for a movement made of many autonomous groups — like a network of ecovillages, cooperatives or grassroots initiatives that want to stand together without giving up local self-governance.\"],\"accountsTitle\":\"One Login, Many Communities\",\"accountsTags\":[\"Global Accounts\",\"Per-Community Roles\",\"Portable Identity\",\"Verified Membership\"],\"accounts\":[\"Every person has a single Cocoso account, wherever their communities live. Join a cooperative here, a festival there, an ecovillage somewhere else — one identity travels with you, while your role and visibility are set independently in each place.\",\"Admins verify members community by community, granting the right to publish activities, run a group or manage resources locally — without ever needing to touch another community's settings or members.\"],\"dataTitle\":\"Own Your Data\",\"dataTags\":[\"No Tracking\",\"No Third Parties\",\"Data Sovereignty\",\"Privacy by Design\"],\"data\":[\"Cocoso doesn't feature tools for spying on users or tracking their data. No information is shared with any third-party service or advertiser — the data belongs to the community that created it, full stop.\",\"Every member decides how much of their own information to share, and every community decides how much of its activity to expose to the wider federation. You run your projects, and your data, on your own terms.\"],\"openSourceTitle\":\"Open Source\",\"openSourceTags\":[\"Self-Hostable\",\"Community-Driven\",\"Transparent\",\"Free as in Freedom\"],\"openSource\":[\"Cocoso is free, open-source software developed in the open — you can read every line of it, run it on your own server, or trust a host of your choosing. There's no vendor lock-in and no black box.\",\"It's shaped by the communities that use it: artists, cooperatives, alternative-currency projects and co-creative spaces feeding real needs back into the project since its earliest days.\"],\"ctaTitle\":\"See Everything Cocoso Can Do\",\"ctaBody\":\"From the calendar to the admin panel, every feature is built to be picked up by a community, not a webmaster. Explore what's inside.\",\"ctaButton\":\"Explore Features\",\"ctaSecondary\":\"Or just say hello\"},\"features\":{\"pageTitle\":\"Features\",\"pageLead\":\"Cocoso in detail — every tool your community can pick up, and how it works.\",\"groupCommunityTitle\":\"For Your Community\",\"groupAdminTitle\":\"For Admins\",\"activityTitle\":\"Activities\",\"activityTags\":[\"Public Events\",\"RSVP\",\"Work-in-Progresses\",\"Performances\",\"Exhibitions\",\"Concerts\",\"Conferences\",\"Internals\",\"Bookings\"],\"activities\":[\"The earliest version of Cocoso was built for an artist-run dance theatre and co-learning space, hosting multiple public stage performances for pre-registered audiences. Managing and publishing customisable, recurring events requires several different features, RSVP among them. Registrations are communicated to guests by email, and event admins can verify arrivals at the door.\",\"You can create, edit and delete content with an image, title, description and further info, plus a set of occurrences with optionally multiple dates and times — so admins never need to create a new entry for every single occurrence.\"],\"resourceTitle\":\"Resources\",\"resourceTags\":[\"Resource Sharing\",\"Management of Commons\"],\"resources\":[\"Cocoso enables planning and overviewing of resource-sharing processes in a timely manner. Every time a verified user claims a physical resource or books a space, that information is shared with members of the collective through the calendar.\",\"There are no calendar invites. We believe machines should help us facilitate our own communications and sharing — not operate and act for us. Cocoso's calendar is the main facade of community events and resource sharing, so that we keep talking to each other, the same way we free our emails from data clutter.\"],\"calendarTitle\":\"Calendar\",\"calendarTags\":[\"Scheduling\",\"Agenda\",\"Sharing of Commons\",\"Programming Activities\",\"Bookings of Resources\"],\"calendar\":[\"Cocoso's web calendar can display Monthly, Weekly or Daily events and resource updates, and users can navigate between these timeframes with a single tap. Each entry can correspond to a resource-utilisation activity or a community event.\",\"Every entry can be assigned a category — a resource booked, or a type of activity such as yoga — useful for both public activity listings and internal or private bookings. Like every feature in Cocoso, it's intentionally abstract enough to fit very different use cases.\"],\"groupTitle\":\"Groups\",\"groupTags\":[\"Study Groups\",\"Schools\",\"Co-creation\",\"Recurring Events\",\"Shared Documents\",\"Member Activities\"],\"groups\":[\"A Group is a concept, and a set of conceptually-driven activities pursued by a set of people — virtually or in person. Under a group, members can carry out collaborative activities with all the practical details, basic info and dates documented on one page.\",\"Groups make it possible to manage training, social or learning activities — recurring yoga sessions, school terms, or any sort of co-creation and continuously evolving process. Admins start one up with an image and some text, and a simple forum, document list, member list and set of dates are ready on one page.\",\"It's basically the toolset for running a school, a recurring session, or a cooperative activity of any kind.\"],\"workTitle\":\"Works\",\"workTags\":[\"Portfolio\",\"Marketplace\",\"Documentation\",\"Presentation\"],\"works\":[\"A Work is a visual, or audiovisual, creation of an artist, researcher, designer, craftsperson or reseller, showcased to the community. Details, images, sound files and videos can be shared within a category of the creator's choice — a tool built for portfolios and marketplaces alike.\",\"A work can also be saved privately for internal use and documentation. It's built to let artists and craftspeople publish and communicate what they do with the rest of the world, as well as keep a record for their own reference.\"],\"memberTitle\":\"Members\",\"memberTags\":[\"Manage Members\",\"Community\",\"Memberships\",\"Verification\",\"Roles \\u0026 Privileges\",\"Followers\"],\"members\":[\"Admins can find, filter and manage every member of the organisation from one place: verify or unverify people for specific abilities, such as publishing activities in the calendar or starting a group.\",\"If you run a yoga studio, for instance, you'll have both teachers and students on one platform — verify your teachers so they can create their own activities, while students can simply participate and RSVP.\",\"Privileges are distributed meaningfully across the community, and every user creates their own account and manages it from there. Passwords are automatically encrypted, so system admins can't read or track them.\"],\"pagesTitle\":\"Composable Pages\",\"pagesTags\":[\"Drag \\u0026 Drop\",\"Landing Pages\",\"Campaigns\",\"Static Pages\",\"No-Code\"],\"pages\":[\"Freely build a landing page, a campaign page, or any static page your community needs — with drag-and-drop blocks for text, images and layout, no code required. What used to be Cocoso's simplest CMS is now a proper page builder.\",\"Every page becomes part of your navigation automatically. Use it for an About page, a set of terms, a one-off campaign, or a whole new section of your site — composed freely, published instantly.\"],\"adminTitle\":\"Admin Panel\",\"adminTags\":[\"Organisation Setup\",\"Branding\",\"Menu \\u0026 Navigation\",\"Header \\u0026 Footer\",\"Settings\"],\"admin\":[\"A dedicated admin panel to set up your organisation from the ground up: name, logo, contact details, and every setting that shapes how your community presents itself — no code required.\",\"Tailor your menu, header and footer, and decide exactly what visitors see first. It's the control room behind every Cocoso community, built for admins, not developers.\"],\"designTitle\":\"Design Preferences\",\"designTags\":[\"Colors\",\"Border Radius\",\"Backgrounds\",\"Look \\u0026 Feel\"],\"design\":[\"Give your community's site its own visual identity: pick your colors, adjust border radius, set a background — make it look distinctly yours, without touching a single line of CSS.\",\"Design preferences apply across your whole site at once, so your community's presence stays coherent as it grows, from the homepage to the calendar to every composable page.\"],\"newsletterTitle\":\"Newsletter \\u0026 Emails\",\"newsletterTags\":[\"Email Newsletter\",\"Automated Emails\",\"Member Communication\"],\"newsletter\":[\"Reach every member directly with an email newsletter — no separate mailing-list tool required. Write once, send to your whole community, and keep people in the loop without relying on a social feed.\",\"Automated emails handle the routine moments for you: registration confirmations, RSVP verifications and other member notifications go out on their own, so admins can focus on the community instead of the inbox.\"]},\"clients\":{\"pageTitle\":\"Example Uses\",\"pageLead\":\"Real communities, studios and artists already running on Cocoso — federated networks, shared workspaces, event calendars and personal portfolios, each shaped to fit.\",\"samarbetetTitle\":\"Samarbetet\",\"samarbetetTags\":[\"Sweden\",\"Federation\",\"Artists \\u0026 Cultural Spaces\"],\"samarbetet\":[\"Samarbetet is a federation of independent communities across Sweden — artists, art spaces, gardens, workshops and people, connected under one shared network.\",\"Its members pool stages, gardens, workshops and meeting spaces, run their own programs and shops, and stay independent while benefiting from a shared front door into the whole ecosystem.\"],\"samarbetetLinkLabel\":\"Visit samarbetet.org\",\"kkvTitle\":\"KKV Stockholm\",\"kkvTags\":[\"Resource Booking\",\"200+ Resources\",\"400+ Members\"],\"kkv\":[\"KKV Stockholm — Konstnärernas Kollektivverkstad — is a collective workspace for professional artists, giving over 400 members shared access to more than 200 pieces of equipment and workshop space.\",\"Members book resources through Cocoso's calendar, publish their own portfolios and public events, and find each other on a shared members page — a big, busy workshop run smoothly on one platform.\"],\"kkvLinkLabel\":\"Visit stockholm.kkv.nu\",\"hojdenTitle\":\"höjden\",\"hojdenTags\":[\"Artist-Run Space\",\"Resource Booking\",\"Portfolios\"],\"hojden\":[\"höjden is an artist-run space in Stockholm — studios, a stage, a dance floor, a gallery and a kitchen, run collectively by the cooperative Släktet since 2018.\",\"Like KKV, höjden uses Cocoso to manage bookings of its shared spaces and equipment, alongside member portfolios and a public program of workshops, performances and lectures.\"],\"hojdenLinkLabel\":\"Visit hojden.house\",\"gerlesborgTitle\":\"Gerlesborgs Kulturhus\",\"gerlesborgTags\":[\"Cultural Center\",\"Public Events\",\"Calendar\"],\"gerlesborg\":[\"Gerlesborgs kulturhus is a cultural centre in Hamburgsund, Sweden, hosting exhibitions, concerts, workshops and a literature festival for the surrounding community.\",\"It uses Cocoso simply and effectively to publish its public program — every exhibition, concert and course appears straight on its calendar, no separate events tool required.\"],\"gerlesborgLinkLabel\":\"Visit gerlesborgskulturhus.se\",\"minaTitle\":\"Mîna Kocailik\",\"minaTags\":[\"Portfolio\",\"Independent Artist\"],\"mina\":[\"Mîna Kocailik is an independent artist who uses Cocoso simply to publish her portfolio: a clean, self-managed showcase of her work, with nothing extra to maintain.\",\"It's the smallest possible use of Cocoso — proof that the same platform serving federations of hundreds works just as well for a single creative practice.\"],\"minaLinkLabel\":\"Visit her portfolio\"},\"credits\":{\"title\":\"Credits\",\"first\":\"Developed in a fantastic collaboration with\",\"second\":\"Supported by\"},\"contact\":{\"title\":\"Contact\",\"heading\":\"We can work together\",\"body\":\"Do you have a project that could use Cocoso? Or do you just want to say hi and become friends? Drop us a message here, and we'll get back to you!\",\"email\":\"Your email address\",\"subject\":\"Subject\",\"message\":\"Message\",\"send\":\"Send\"},\"footer\":{\"tagline\":\"Open-source software for federations of communities, cooperatives and grassroots groups — a public website and a private intranet, always on your own terms.\",\"exploreTitle\":\"Explore\",\"projectTitle\":\"Project\",\"license\":\"Free and open-source, licensed under the GNU GPLv3.\",\"bottom\":\"© {{year}} Cocoso. Built for autonomous communities everywhere.\"},\"source\":\"Source\"}}},\"__N_SSG\":true},\"page\":\"/contact\",\"query\":{},\"buildId\":\"8Gn-t-Zu06iNrcJME3BxD\",\"isFallback\":false,\"gsp\":true,\"locale\":\"en\",\"locales\":[\"en\",\"sv\",\"tr\",\"de\",\"es\",\"pt-PT\",\"pt-BR\"],\"defaultLocale\":\"en\",\"scriptLoader\":[]}</script></body></html>","json":{"pageProps":{"__lang":"en","__namespaces":{"common":{"meta":{"title":"Cocoso — Community Cooperation Software","description":"Open-source software for federations of communities, cooperatives and grassroots groups — calendar, resources, events, groups, composable pages and more, always on your own terms."},"brand":{"title":"COCOSO","slogan":"Community Cooperation Software"},"nav":{"home":"Home","features":"Features","examples":"Examples","contact":"Contact","sourceCode":"Source Code","getStarted":"Explore Features","demo":"Live Demo","language":"Language"},"home":{"leadTitle":"Software for Autonomous, Federated Communities","lead":["Cocoso is open-source software for autonomous communities: a public website and a private intranet, in one place. It's built for cooperatives, ecovillages, artist-run spaces, festivals and grassroots groups who want to run their own operations, on their own terms.","One login. Many communities. Your data, always yours."],"leadTags":["Online Platforms","Cooperatives","Non-Profits","Festivals","Conferences","Artist Run Spaces","Eco Villages","Communities","Camp Sites"],"tripleTitle":"More Than a Website","tripleTags":["Public Website","Community Network","Productivity Tool"],"triple":["Cocoso is a public website, so the world can see who you are, what you do, and what's coming up — no separate site needed.","It's also a private community network: members can follow activities, share updates and stay in the loop with each other, without ads, algorithms or tracking — social media, minus the extraction.","And it's a real productivity tool for the practical side of running a community: a shared calendar, resource bookings, RSVPs and admin tools that keep everyone on the same page."],"federationTitle":"Federation","federationTags":["Multi-Community Network","Portal","Shared Discovery","Autonomous by Default"],"federation":["Cocoso isn't limited to a single group. One deployment can host an entire federation of independent communities — each with its own domain, its own look and feel, its own members — while staying discoverable as part of a wider network.","A federation can designate one community as its Portal: a shared front door where visitors browse every member community, filter activities across the whole network, and find their way in. Everyone keeps their independence; the network keeps its cohesion.","It's a natural fit for a movement made of many autonomous groups — like a network of ecovillages, cooperatives or grassroots initiatives that want to stand together without giving up local self-governance."],"accountsTitle":"One Login, Many Communities","accountsTags":["Global Accounts","Per-Community Roles","Portable Identity","Verified Membership"],"accounts":["Every person has a single Cocoso account, wherever their communities live. Join a cooperative here, a festival there, an ecovillage somewhere else — one identity travels with you, while your role and visibility are set independently in each place.","Admins verify members community by community, granting the right to publish activities, run a group or manage resources locally — without ever needing to touch another community's settings or members."],"dataTitle":"Own Your Data","dataTags":["No Tracking","No Third Parties","Data Sovereignty","Privacy by Design"],"data":["Cocoso doesn't feature tools for spying on users or tracking their data. No information is shared with any third-party service or advertiser — the data belongs to the community that created it, full stop.","Every member decides how much of their own information to share, and every community decides how much of its activity to expose to the wider federation. You run your projects, and your data, on your own terms."],"openSourceTitle":"Open Source","openSourceTags":["Self-Hostable","Community-Driven","Transparent","Free as in Freedom"],"openSource":["Cocoso is free, open-source software developed in the open — you can read every line of it, run it on your own server, or trust a host of your choosing. There's no vendor lock-in and no black box.","It's shaped by the communities that use it: artists, cooperatives, alternative-currency projects and co-creative spaces feeding real needs back into the project since its earliest days."],"ctaTitle":"See Everything Cocoso Can Do","ctaBody":"From the calendar to the admin panel, every feature is built to be picked up by a community, not a webmaster. Explore what's inside.","ctaButton":"Explore Features","ctaSecondary":"Or just say hello"},"features":{"pageTitle":"Features","pageLead":"Cocoso in detail — every tool your community can pick up, and how it works.","groupCommunityTitle":"For Your Community","groupAdminTitle":"For Admins","activityTitle":"Activities","activityTags":["Public Events","RSVP","Work-in-Progresses","Performances","Exhibitions","Concerts","Conferences","Internals","Bookings"],"activities":["The earliest version of Cocoso was built for an artist-run dance theatre and co-learning space, hosting multiple public stage performances for pre-registered audiences. Managing and publishing customisable, recurring events requires several different features, RSVP among them. Registrations are communicated to guests by email, and event admins can verify arrivals at the door.","You can create, edit and delete content with an image, title, description and further info, plus a set of occurrences with optionally multiple dates and times — so admins never need to create a new entry for every single occurrence."],"resourceTitle":"Resources","resourceTags":["Resource Sharing","Management of Commons"],"resources":["Cocoso enables planning and overviewing of resource-sharing processes in a timely manner. Every time a verified user claims a physical resource or books a space, that information is shared with members of the collective through the calendar.","There are no calendar invites. We believe machines should help us facilitate our own communications and sharing — not operate and act for us. Cocoso's calendar is the main facade of community events and resource sharing, so that we keep talking to each other, the same way we free our emails from data clutter."],"calendarTitle":"Calendar","calendarTags":["Scheduling","Agenda","Sharing of Commons","Programming Activities","Bookings of Resources"],"calendar":["Cocoso's web calendar can display Monthly, Weekly or Daily events and resource updates, and users can navigate between these timeframes with a single tap. Each entry can correspond to a resource-utilisation activity or a community event.","Every entry can be assigned a category — a resource booked, or a type of activity such as yoga — useful for both public activity listings and internal or private bookings. Like every feature in Cocoso, it's intentionally abstract enough to fit very different use cases."],"groupTitle":"Groups","groupTags":["Study Groups","Schools","Co-creation","Recurring Events","Shared Documents","Member Activities"],"groups":["A Group is a concept, and a set of conceptually-driven activities pursued by a set of people — virtually or in person. Under a group, members can carry out collaborative activities with all the practical details, basic info and dates documented on one page.","Groups make it possible to manage training, social or learning activities — recurring yoga sessions, school terms, or any sort of co-creation and continuously evolving process. Admins start one up with an image and some text, and a simple forum, document list, member list and set of dates are ready on one page.","It's basically the toolset for running a school, a recurring session, or a cooperative activity of any kind."],"workTitle":"Works","workTags":["Portfolio","Marketplace","Documentation","Presentation"],"works":["A Work is a visual, or audiovisual, creation of an artist, researcher, designer, craftsperson or reseller, showcased to the community. Details, images, sound files and videos can be shared within a category of the creator's choice — a tool built for portfolios and marketplaces alike.","A work can also be saved privately for internal use and documentation. It's built to let artists and craftspeople publish and communicate what they do with the rest of the world, as well as keep a record for their own reference."],"memberTitle":"Members","memberTags":["Manage Members","Community","Memberships","Verification","Roles & Privileges","Followers"],"members":["Admins can find, filter and manage every member of the organisation from one place: verify or unverify people for specific abilities, such as publishing activities in the calendar or starting a group.","If you run a yoga studio, for instance, you'll have both teachers and students on one platform — verify your teachers so they can create their own activities, while students can simply participate and RSVP.","Privileges are distributed meaningfully across the community, and every user creates their own account and manages it from there. Passwords are automatically encrypted, so system admins can't read or track them."],"pagesTitle":"Composable Pages","pagesTags":["Drag & Drop","Landing Pages","Campaigns","Static Pages","No-Code"],"pages":["Freely build a landing page, a campaign page, or any static page your community needs — with drag-and-drop blocks for text, images and layout, no code required. What used to be Cocoso's simplest CMS is now a proper page builder.","Every page becomes part of your navigation automatically. Use it for an About page, a set of terms, a one-off campaign, or a whole new section of your site — composed freely, published instantly."],"adminTitle":"Admin Panel","adminTags":["Organisation Setup","Branding","Menu & Navigation","Header & Footer","Settings"],"admin":["A dedicated admin panel to set up your organisation from the ground up: name, logo, contact details, and every setting that shapes how your community presents itself — no code required.","Tailor your menu, header and footer, and decide exactly what visitors see first. It's the control room behind every Cocoso community, built for admins, not developers."],"designTitle":"Design Preferences","designTags":["Colors","Border Radius","Backgrounds","Look & Feel"],"design":["Give your community's site its own visual identity: pick your colors, adjust border radius, set a background — make it look distinctly yours, without touching a single line of CSS.","Design preferences apply across your whole site at once, so your community's presence stays coherent as it grows, from the homepage to the calendar to every composable page."],"newsletterTitle":"Newsletter & Emails","newsletterTags":["Email Newsletter","Automated Emails","Member Communication"],"newsletter":["Reach every member directly with an email newsletter — no separate mailing-list tool required. Write once, send to your whole community, and keep people in the loop without relying on a social feed.","Automated emails handle the routine moments for you: registration confirmations, RSVP verifications and other member notifications go out on their own, so admins can focus on the community instead of the inbox."]},"clients":{"pageTitle":"Example Uses","pageLead":"Real communities, studios and artists already running on Cocoso — federated networks, shared workspaces, event calendars and personal portfolios, each shaped to fit.","samarbetetTitle":"Samarbetet","samarbetetTags":["Sweden","Federation","Artists & Cultural Spaces"],"samarbetet":["Samarbetet is a federation of independent communities across Sweden — artists, art spaces, gardens, workshops and people, connected under one shared network.","Its members pool stages, gardens, workshops and meeting spaces, run their own programs and shops, and stay independent while benefiting from a shared front door into the whole ecosystem."],"samarbetetLinkLabel":"Visit samarbetet.org","kkvTitle":"KKV Stockholm","kkvTags":["Resource Booking","200+ Resources","400+ Members"],"kkv":["KKV Stockholm — Konstnärernas Kollektivverkstad — is a collective workspace for professional artists, giving over 400 members shared access to more than 200 pieces of equipment and workshop space.","Members book resources through Cocoso's calendar, publish their own portfolios and public events, and find each other on a shared members page — a big, busy workshop run smoothly on one platform."],"kkvLinkLabel":"Visit stockholm.kkv.nu","hojdenTitle":"höjden","hojdenTags":["Artist-Run Space","Resource Booking","Portfolios"],"hojden":["höjden is an artist-run space in Stockholm — studios, a stage, a dance floor, a gallery and a kitchen, run collectively by the cooperative Släktet since 2018.","Like KKV, höjden uses Cocoso to manage bookings of its shared spaces and equipment, alongside member portfolios and a public program of workshops, performances and lectures."],"hojdenLinkLabel":"Visit hojden.house","gerlesborgTitle":"Gerlesborgs Kulturhus","gerlesborgTags":["Cultural Center","Public Events","Calendar"],"gerlesborg":["Gerlesborgs kulturhus is a cultural centre in Hamburgsund, Sweden, hosting exhibitions, concerts, workshops and a literature festival for the surrounding community.","It uses Cocoso simply and effectively to publish its public program — every exhibition, concert and course appears straight on its calendar, no separate events tool required."],"gerlesborgLinkLabel":"Visit gerlesborgskulturhus.se","minaTitle":"Mîna Kocailik","minaTags":["Portfolio","Independent Artist"],"mina":["Mîna Kocailik is an independent artist who uses Cocoso simply to publish her portfolio: a clean, self-managed showcase of her work, with nothing extra to maintain.","It's the smallest possible use of Cocoso — proof that the same platform serving federations of hundreds works just as well for a single creative practice."],"minaLinkLabel":"Visit her portfolio"},"credits":{"title":"Credits","first":"Developed in a fantastic collaboration with","second":"Supported by"},"contact":{"title":"Contact","heading":"We can work together","body":"Do you have a project that could use Cocoso? Or do you just want to say hi and become friends? Drop us a message here, and we'll get back to you!","email":"Your email address","subject":"Subject","message":"Message","send":"Send"},"footer":{"tagline":"Open-source software for federations of communities, cooperatives and grassroots groups — a public website and a private intranet, always on your own terms.","exploreTitle":"Explore","projectTitle":"Project","license":"Free and open-source, licensed under the GNU GPLv3.","bottom":"© {{year}} Cocoso. Built for autonomous communities everywhere."},"source":"Source"}}},"__N_SSG":true}}