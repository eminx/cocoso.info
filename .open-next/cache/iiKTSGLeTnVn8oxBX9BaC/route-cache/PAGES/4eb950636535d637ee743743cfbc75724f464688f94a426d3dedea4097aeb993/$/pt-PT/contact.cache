{"type":"page","meta":{"routeCache":{"key":"/route-cache/PAGES/4eb950636535d637ee743743cfbc75724f464688f94a426d3dedea4097aeb993/$/pt-PT/contact","owner":{"kind":"PAGES","sourceRoute":"/contact"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"pt-PT\"><head><meta charSet=\"utf-8\" data-next-head=\"\"/><meta name=\"viewport\" content=\"width=device-width\" data-next-head=\"\"/><title data-next-head=\"\"></title><link rel=\"preload\" href=\"/_next/static/css/544d7195a2962901.css\" as=\"style\"/><link rel=\"stylesheet\" href=\"/_next/static/css/544d7195a2962901.css\" data-n-g=\"\"/><noscript data-n-css=\"\"></noscript><script defer=\"\" noModule=\"\" src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\"></script><script src=\"/_next/static/chunks/webpack-ccef31ea74e09183.js\" defer=\"\"></script><script src=\"/_next/static/chunks/framework-ce4420da925a97d0.js\" defer=\"\"></script><script src=\"/_next/static/chunks/main-ea9a9e30635b143d.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/_app-4744dc754b095ee4.js\" defer=\"\"></script><script src=\"/_next/static/chunks/994-8e268744597e86c6.js\" defer=\"\"></script><script src=\"/_next/static/chunks/226-c328413f0b133673.js\" defer=\"\"></script><script src=\"/_next/static/chunks/892-e8704383fee96620.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/contact-16cce143af8c1c33.js\" defer=\"\"></script><script src=\"/_next/static/iiKTSGLeTnVn8oxBX9BaC/_buildManifest.js\" defer=\"\"></script><script src=\"/_next/static/iiKTSGLeTnVn8oxBX9BaC/_ssgManifest.js\" defer=\"\"></script><style id=\"__jsx-8df70e60372d0001\">@import url(\"https://fonts.googleapis.com/css2?family=Sarabun:wght@500;800&family=Inknut+Antiqua:wght@700&display=swap\");</style><style data-styled=\"\" data-styled-version=\"5.3.11\">.dASfzA{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;box-sizing:border-box;max-width:100%;margin-bottom:8px;min-width:0;min-height:0;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;}/*!sc*/\n@media only screen and (max-width:768px){.dASfzA{margin-bottom:6px;}}/*!sc*/\n.gbHrCl{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;box-sizing:border-box;max-width:100%;border-bottom:solid 1px rgba(0,0,0,0.33);min-width:0;min-height:0;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;}/*!sc*/\n@media only screen and (max-width:768px){.gbHrCl{border-bottom:solid 1px rgba(0,0,0,0.33);}}/*!sc*/\n.hSapUm{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;box-sizing:border-box;max-width:100%;min-width:0;min-height:0;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;padding-top:16px;}/*!sc*/\n@media only screen and (max-width:768px){.hSapUm{padding-top:12px;}}/*!sc*/\ndata-styled.g2[id=\"StyledBox-sc-13pk1d4-0\"]{content:\"dASfzA,gbHrCl,hSapUm,\"}/*!sc*/\n.iRjCgM{margin-left:8px;margin-right:8px;margin-top:4px;margin-bottom:4px;font-size:18px;line-height:1.375;}/*!sc*/\ndata-styled.g9[id=\"StyledText-sc-1sadyjn-0\"]{content:\"iRjCgM,\"}/*!sc*/\n.eRXQcD{display:inline-block;box-sizing:border-box;cursor:pointer;font:inherit;-webkit-text-decoration:none;text-decoration:none;margin:0;background:transparent;overflow:visible;text-transform:none;-webkit-align-self:flex-end;-ms-flex-item-align:end;align-self:flex-end;border:3px solid #211a17;border-radius:999px;color:#444444;padding:4px 22px;font-size:18px;line-height:1.375;-webkit-transition-property:color,background-color,border-color,box-shadow;transition-property:color,background-color,border-color,box-shadow;-webkit-transition-duration:0.1s;transition-duration:0.1s;-webkit-transition-timing-function:ease-in-out;transition-timing-function:ease-in-out;}/*!sc*/\n.eRXQcD:hover{box-shadow:0px 0px 0px 2px #211a17;}/*!sc*/\n.eRXQcD:focus{outline:none;box-shadow:0 0 2px 2px #FF6F59;}/*!sc*/\n.eRXQcD:focus > circle,.eRXQcD:focus > ellipse,.eRXQcD:focus > line,.eRXQcD:focus > path,.eRXQcD:focus > polygon,.eRXQcD:focus > polyline,.eRXQcD:focus > rect{outline:none;box-shadow:0 0 2px 2px #FF6F59;}/*!sc*/\n.eRXQcD:focus::-moz-focus-inner{border:0;}/*!sc*/\n.eRXQcD:focus:not(:focus-visible){outline:none;box-shadow:none;}/*!sc*/\n.eRXQcD:focus:not(:focus-visible) > circle,.eRXQcD:focus:not(:focus-visible) > ellipse,.eRXQcD:focus:not(:focus-visible) > line,.eRXQcD:focus:not(:focus-visible) > path,.eRXQcD:focus:not(:focus-visible) > polygon,.eRXQcD:focus:not(:focus-visible) > polyline,.eRXQcD:focus:not(:focus-visible) > rect{outline:none;box-shadow:none;}/*!sc*/\n.eRXQcD:focus:not(:focus-visible)::-moz-focus-inner{border:0;}/*!sc*/\ndata-styled.g11[id=\"StyledButton-sc-323bzc-0\"]{content:\"eRXQcD,\"}/*!sc*/\n.dotoLH{box-sizing:border-box;font-size:inherit;font-family:inherit;border:none;-webkit-appearance:none;background:transparent;color:inherit;width:100%;padding:11px;font-weight:600;margin:0;border:1px solid rgba(0,0,0,0.33);border-radius:4px;outline:none;border:none;}/*!sc*/\n.dotoLH::-webkit-input-placeholder{color:#AAAAAA;}/*!sc*/\n.dotoLH::-moz-placeholder{color:#AAAAAA;}/*!sc*/\n.dotoLH:-ms-input-placeholder{color:#AAAAAA;}/*!sc*/\n.dotoLH::-webkit-search-decoration{-webkit-appearance:none;}/*!sc*/\n.dotoLH::-moz-focus-inner{border:none;outline:none;}/*!sc*/\n.dotoLH:-moz-placeholder,.dotoLH::-moz-placeholder{opacity:1;}/*!sc*/\ndata-styled.g34[id=\"StyledTextInput-sc-1x30a0s-0\"]{content:\"dotoLH,\"}/*!sc*/\n.kuczHv{position:relative;width:100%;}/*!sc*/\ndata-styled.g35[id=\"StyledTextInput__StyledTextInputContainer-sc-1x30a0s-1\"]{content:\"kuczHv,\"}/*!sc*/\n.gvavzw{font-family:'Sarabun',sans-serif;font-size:16px;line-height:24px;background-color:hsla(88,62%,90%,0.1);color:#444444;box-sizing:border-box;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;-moz-osx-font-smoothing:grayscale;-webkit-font-smoothing:antialiased;}/*!sc*/\ndata-styled.g145[id=\"StyledGrommet-sc-19lkkz7-0\"]{content:\"gvavzw,\"}/*!sc*/\n.iUKQxO{box-sizing:border-box;font-size:inherit;font-family:inherit;border:none;-webkit-appearance:none;background:transparent;color:inherit;width:100%;padding:11px;font-weight:600;margin:0;border:1px solid rgba(0,0,0,0.33);border-radius:4px;outline:none;border:none;width:100%;-webkit-appearance:none;max-width:100%;}/*!sc*/\n.iUKQxO::-webkit-input-placeholder{color:#AAAAAA;}/*!sc*/\n.iUKQxO::-moz-placeholder{color:#AAAAAA;}/*!sc*/\n.iUKQxO:-ms-input-placeholder{color:#AAAAAA;}/*!sc*/\n.iUKQxO::-webkit-search-decoration{-webkit-appearance:none;}/*!sc*/\n.iUKQxO::-moz-focus-inner{border:none;outline:none;}/*!sc*/\n.iUKQxO:-moz-placeholder,.iUKQxO::-moz-placeholder{opacity:1;}/*!sc*/\ndata-styled.g163[id=\"StyledTextArea-sc-17i3mwp-0\"]{content:\"iUKQxO,\"}/*!sc*/\n</style></head><body><link rel=\"preload\" as=\"image\" href=\"/cocoso-logo-small.png\"/><div id=\"__next\"><div class=\"StyledGrommet-sc-19lkkz7-0 gvavzw\"><nav class=\"top-nav--desktop\"><a class=\"top-nav-logo\" href=\"/pt-PT\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"top-nav-links\"><a href=\"/pt-PT\"><span class=\"top-nav-link\">Início</span></a><a href=\"/pt-PT/features\"><span class=\"top-nav-link\">Funcionalidades</span></a><a href=\"/pt-PT/clients\"><span class=\"top-nav-link\">Exemplos</span></a><a href=\"/pt-PT/contact\"><span class=\"top-nav-link nav-item-active\">Contacto</span></a></div><a class=\"btn-demo\" href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Demonstração ao Vivo</a><div class=\"nav-dropdown\"><button type=\"button\" class=\"lang-trigger\">Português (Portugal)<svg width=\"10\" height=\"7\" viewBox=\"0 0 10 7\" fill=\"none\"><path d=\"M1 1L5 5.5L9 1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></div></nav><nav class=\"top-nav-mobile-bar\"><a class=\"top-nav-logo\" href=\"/pt-PT\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/></a><div class=\"nav-dropdown\"><button type=\"button\" class=\"burger-trigger\" aria-label=\"Menu\"><svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" fill=\"none\"><path d=\"M0 1H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 8H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path><path d=\"M0 15H20\" stroke=\"currentColor\" stroke-width=\"2.4\"></path></svg></button></div></nav><div class=\"simple-page\"><div class=\"simple-card\"><h1 class=\"simple-title\">Podemos trabalhar juntos</h1><p class=\"simple-body\">Tem um projeto em que o Cocoso possa ser útil? Ou só quer dizer olá e tornar-se nosso amigo? Deixe-nos aqui uma mensagem, e entraremos em contacto consigo!</p><form action=\"https://formspree.io/f/xpqrdwpl\" method=\"POST\"><div class=\"StyledBox-sc-13pk1d4-0 dASfzA FormField__FormFieldBox-sc-m9hood-0 FCiZz\"><label class=\"StyledText-sc-1sadyjn-0 iRjCgM\">O seu endereço de e-mail</label><div class=\"StyledBox-sc-13pk1d4-0 gbHrCl FormField__FormFieldContentBox-sc-m9hood-1 fuEJvP\"><div class=\"StyledTextInput__StyledTextInputContainer-sc-1x30a0s-1 kuczHv\"><input autoComplete=\"off\" type=\"email\" class=\"StyledTextInput-sc-1x30a0s-0 dotoLH\" name=\"email\"/></div></div></div><div class=\"StyledBox-sc-13pk1d4-0 dASfzA FormField__FormFieldBox-sc-m9hood-0 FCiZz\"><label class=\"StyledText-sc-1sadyjn-0 iRjCgM\">Assunto</label><div class=\"StyledBox-sc-13pk1d4-0 gbHrCl FormField__FormFieldContentBox-sc-m9hood-1 fuEJvP\"><div class=\"StyledTextInput__StyledTextInputContainer-sc-1x30a0s-1 kuczHv\"><input autoComplete=\"off\" class=\"StyledTextInput-sc-1x30a0s-0 dotoLH\" name=\"subject\"/></div></div></div><div class=\"StyledBox-sc-13pk1d4-0 dASfzA FormField__FormFieldBox-sc-m9hood-0 FCiZz\"><label class=\"StyledText-sc-1sadyjn-0 iRjCgM\">Mensagem</label><div class=\"StyledBox-sc-13pk1d4-0 gbHrCl FormField__FormFieldContentBox-sc-m9hood-1 fuEJvP\"><textarea name=\"message\" class=\"StyledTextArea-sc-17i3mwp-0 iUKQxO\"></textarea></div></div><div class=\"StyledBox-sc-13pk1d4-0 hSapUm\"><button type=\"submit\" class=\"StyledButton-sc-323bzc-0 eRXQcD\">Enviar</button></div></form></div></div><footer class=\"site-footer\"><div class=\"footer-rainbow\"></div><div class=\"footer-inner\"><div class=\"footer-brand\"><img src=\"/cocoso-logo-small.png\" alt=\"Cocoso\"/><p>Software de código aberto para federações de comunidades, cooperativas e grupos de base — um site público e uma intranet privada, sempre nos seus próprios termos.</p></div><div class=\"footer-col\"><p class=\"footer-col-title\">Explorar</p><a href=\"/pt-PT\">Início</a><a href=\"/pt-PT/features\">Funcionalidades</a><a href=\"/pt-PT/clients\">Exemplos</a><a href=\"/pt-PT/contact\">Contacto</a></div><div class=\"footer-col\"><p class=\"footer-col-title\">Projeto</p><a href=\"https://github.com/eminx/cocoso\" target=\"_blank\" rel=\"noopener noreferrer\">Código-Fonte</a><a href=\"https://demo.artistrun.space\" target=\"_blank\" rel=\"noopener noreferrer\">Demonstração ao Vivo</a><p class=\"footer-license\">Livre e de código aberto, licenciado sob a GNU GPLv3.</p></div></div><div class=\"footer-bottom\"><p>© 2026 Cocoso. Criado para comunidades autónomas em todo o lado.</p></div></footer></div></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"__lang\":\"pt-PT\",\"__namespaces\":{\"common\":{\"meta\":{\"title\":\"Cocoso — Software de Cooperação Comunitária\",\"description\":\"Software de código aberto para federações de comunidades, cooperativas e grupos de base — calendário, recursos, eventos, grupos, páginas compósitas e muito mais, sempre nos seus próprios termos.\"},\"brand\":{\"title\":\"COCOSO\",\"slogan\":\"Software de Cooperação Comunitária\"},\"nav\":{\"home\":\"Início\",\"features\":\"Funcionalidades\",\"examples\":\"Exemplos\",\"contact\":\"Contacto\",\"sourceCode\":\"Código-Fonte\",\"getStarted\":\"Explorar Funcionalidades\",\"demo\":\"Demonstração ao Vivo\",\"language\":\"Idioma\"},\"home\":{\"leadTitle\":\"Software para Comunidades Autónomas e Federadas\",\"lead\":[\"O Cocoso é software de código aberto para comunidades autónomas: um site público e uma intranet, num só lugar. Foi construído para cooperativas, ecoaldeias, espaços autogeridos por artistas, festivais e grupos de base que querem gerir as suas próprias operações, nos seus próprios termos.\",\"Um único início de sessão. Muitas comunidades. Os seus dados, sempre seus.\"],\"leadTags\":[\"Plataformas Online\",\"Cooperativas\",\"Organizações Sem Fins Lucrativos\",\"Festivais\",\"Conferências\",\"Espaços Autogeridos por Artistas\",\"Ecoaldeias\",\"Comunidades\",\"Parques de Campismo\"],\"tripleTitle\":\"Mais do que um Site\",\"tripleTags\":[\"Site Público\",\"Rede Comunitária\",\"Ferramenta de Produtividade\"],\"triple\":[\"O Cocoso é um site público, para que o mundo veja quem são, o que fazem e o que aí vem — sem necessidade de um site à parte.\",\"É também uma rede comunitária privada: os membros podem seguir atividades, partilhar novidades e manter-se em contacto uns com os outros — sem anúncios, algoritmos ou rastreamento. Redes sociais, sem a exploração de dados.\",\"E é uma verdadeira ferramenta de produtividade para o lado prático de gerir uma comunidade: um calendário partilhado, reservas de recursos, confirmações de presença e ferramentas de administração que mantêm todos a par.\"],\"federationTitle\":\"Federação\",\"federationTags\":[\"Rede Multicomunitária\",\"Portal\",\"Descoberta Partilhada\",\"Autónoma por Definição\"],\"federation\":[\"O Cocoso não está limitado a um único grupo. Uma única instalação pode alojar toda uma federação de comunidades independentes — cada uma com o seu próprio domínio, a sua própria identidade visual, os seus próprios membros — mantendo-se visível como parte de uma rede mais alargada.\",\"Uma federação pode designar uma comunidade como o seu Portal: uma porta de entrada partilhada onde os visitantes navegam por cada comunidade-membro, filtram atividades em toda a rede e encontram o seu caminho. Cada uma mantém a sua independência; a rede mantém a sua coesão.\",\"É uma solução natural para um movimento composto por muitos grupos autónomos — como uma rede de ecoaldeias, cooperativas ou iniciativas de base que querem manter-se unidas sem abdicar da autogestão local.\"],\"accountsTitle\":\"Um Início de Sessão, Muitas Comunidades\",\"accountsTags\":[\"Contas Globais\",\"Papéis por Comunidade\",\"Identidade Portátil\",\"Adesão Verificada\"],\"accounts\":[\"Cada pessoa tem uma única conta Cocoso, onde quer que as suas comunidades estejam. Junte-se a uma cooperativa aqui, a um festival ali, a uma ecoaldeia noutro lugar — uma identidade acompanha-o, enquanto o seu papel e visibilidade são definidos de forma independente em cada local.\",\"Os administradores verificam os membros comunidade a comunidade, concedendo o direito de publicar atividades, gerir um grupo ou administrar recursos localmente — sem nunca precisarem de mexer nas definições ou nos membros de outra comunidade.\"],\"dataTitle\":\"Os Seus Dados São Seus\",\"dataTags\":[\"Sem Rastreamento\",\"Sem Terceiros\",\"Soberania dos Dados\",\"Privacidade desde a Conceção\"],\"data\":[\"O Cocoso não tem ferramentas para espiar utilizadores ou rastrear os seus dados. Nenhuma informação é partilhada com serviços de terceiros ou anunciantes — os dados pertencem à comunidade que os criou, ponto final.\",\"Cada membro decide quanto da sua própria informação partilhar, e cada comunidade decide quanto da sua atividade expõe à federação mais alargada. Gere os seus projetos, e os seus dados, nos seus próprios termos.\"],\"openSourceTitle\":\"Código Aberto\",\"openSourceTags\":[\"Pode ser Autoalojado\",\"Orientado pela Comunidade\",\"Transparente\",\"Livre como em Liberdade\"],\"openSource\":[\"O Cocoso é software livre e de código aberto, desenvolvido à vista de todos — pode ler todas as linhas de código, correr o software no seu próprio servidor, ou confiar num alojamento à sua escolha. Sem dependência de fornecedor, sem caixa negra.\",\"É moldado pelas comunidades que o utilizam: artistas, cooperativas, projetos de moeda alternativa e espaços de cocriação que têm devolvido necessidades reais ao projeto desde os seus primeiros dias.\"],\"ctaTitle\":\"Veja Tudo o que o Cocoso Pode Fazer\",\"ctaBody\":\"Do calendário ao painel de administração, cada funcionalidade foi pensada para ser usada por uma comunidade, não por um webmaster. Explore o que aqui está.\",\"ctaButton\":\"Explorar Funcionalidades\",\"ctaSecondary\":\"Ou diga apenas olá\"},\"features\":{\"pageTitle\":\"Funcionalidades\",\"pageLead\":\"O Cocoso em detalhe — cada ferramenta que a sua comunidade pode usar, e como funciona.\",\"groupCommunityTitle\":\"Para a Sua Comunidade\",\"groupAdminTitle\":\"Para Administradores\",\"activityTitle\":\"Atividades\",\"activityTags\":[\"Eventos Públicos\",\"Confirmação de Presença\",\"Trabalhos em Curso\",\"Espetáculos\",\"Exposições\",\"Concertos\",\"Conferências\",\"Internos\",\"Reservas\"],\"activities\":[\"A primeira versão do Cocoso foi construída para um teatro de dança autogerido por artistas e um espaço de coaprendizagem, que acolhia várias representações públicas para um público previamente inscrito. Gerir e publicar eventos personalizáveis e recorrentes exige várias funcionalidades distintas, incluindo a confirmação de presença. As inscrições são comunicadas aos convidados por e-mail, e os administradores do evento podem verificar as chegadas à porta.\",\"Pode criar, editar e eliminar conteúdo com uma imagem, título, descrição e informação adicional, além de um conjunto de datas e horários opcionalmente múltiplos — assim, os administradores nunca precisam de criar uma nova entrada para cada ocorrência.\"],\"resourceTitle\":\"Recursos\",\"resourceTags\":[\"Partilha de Recursos\",\"Gestão de Bens Comuns\"],\"resources\":[\"O Cocoso permite planear e ter uma visão geral atempada dos processos de partilha de recursos. Sempre que um utilizador verificado reserva um recurso físico ou um espaço, essa informação é partilhada com os membros do coletivo através do calendário.\",\"Não há convites de calendário. Acreditamos que as máquinas devem ajudar-nos a facilitar a nossa própria comunicação e partilha — não agir por nós. O calendário do Cocoso é a face principal dos eventos comunitários e da partilha de recursos, para que continuemos a falar uns com os outros, tal como libertamos os nossos e-mails da confusão de dados.\"],\"calendarTitle\":\"Calendário\",\"calendarTags\":[\"Agendamento\",\"Agenda\",\"Partilha de Bens Comuns\",\"Programação de Atividades\",\"Reservas de Recursos\"],\"calendar\":[\"O calendário web do Cocoso pode mostrar eventos e atualizações de recursos mensais, semanais ou diários, e os utilizadores navegam entre estes períodos com um único toque. Cada entrada pode corresponder a uma atividade de utilização de recursos ou a um evento comunitário.\",\"Cada entrada pode ter uma categoria atribuída — um recurso reservado, ou um tipo de atividade como ioga — útil tanto para listagens públicas de atividades como para reservas internas ou privadas. Como qualquer funcionalidade do Cocoso, é intencionalmente abstrata para se adaptar a casos de uso muito diferentes.\"],\"groupTitle\":\"Grupos\",\"groupTags\":[\"Grupos de Estudo\",\"Escolas\",\"Cocriação\",\"Eventos Recorrentes\",\"Documentos Partilhados\",\"Atividades de Membros\"],\"groups\":[\"Um Grupo é um conceito, e um conjunto de atividades conceptualmente orientadas, levadas a cabo por um conjunto de pessoas — de forma virtual ou presencial. Num grupo, os membros podem realizar atividades colaborativas com todos os detalhes práticos, informação básica e datas documentados numa única página.\",\"Os grupos permitem gerir formação, atividades sociais ou de aprendizagem — sessões recorrentes de ioga, períodos escolares, ou qualquer tipo de cocriação e processo em evolução contínua. Os administradores criam um grupo com uma imagem e algum texto, e um fórum simples, uma lista de documentos, uma lista de membros e um conjunto de datas ficam prontos numa única página.\",\"É, no fundo, o conjunto de ferramentas para gerir uma escola, uma sessão recorrente, ou uma atividade cooperativa de qualquer tipo.\"],\"workTitle\":\"Obras\",\"workTags\":[\"Portefólio\",\"Mercado\",\"Documentação\",\"Apresentação\"],\"works\":[\"Uma Obra é uma criação visual, ou audiovisual, de um artista, investigador, designer, artesão ou revendedor, apresentada à comunidade. Detalhes, imagens, ficheiros de áudio e vídeos podem ser partilhados dentro de uma categoria escolhida pelo criador — uma ferramenta pensada tanto para portefólios como para mercados.\",\"Uma obra também pode ser guardada de forma privada, para uso interno e documentação. Foi pensada para permitir que artistas e artesãos publiquem e comuniquem o que fazem ao resto do mundo, mantendo também um registo para referência própria.\"],\"memberTitle\":\"Membros\",\"memberTags\":[\"Gerir Membros\",\"Comunidade\",\"Adesões\",\"Verificação\",\"Papéis e Privilégios\",\"Seguidores\"],\"members\":[\"Os administradores conseguem encontrar, filtrar e gerir todos os membros da organização a partir de um único lugar: verificar ou retirar a verificação de pessoas para capacidades específicas, como publicar atividades no calendário ou criar um grupo.\",\"Se gere um estúdio de ioga, por exemplo, terá tanto professores como alunos na mesma plataforma — verifique os seus professores para que possam criar as suas próprias atividades, enquanto os alunos apenas participam e confirmam presença.\",\"Os privilégios são distribuídos de forma significativa por toda a comunidade, e cada utilizador cria e gere a sua própria conta. As palavras-passe são automaticamente encriptadas, pelo que os administradores do sistema não conseguem lê-las nem rastreá-las.\"],\"pagesTitle\":\"Páginas Compósitas\",\"pagesTags\":[\"Arrastar e Largar\",\"Páginas de Destino\",\"Campanhas\",\"Páginas Estáticas\",\"Sem Código\"],\"pages\":[\"Construa livremente uma página de destino, uma página de campanha, ou qualquer página estática de que a sua comunidade precise — com blocos de arrastar e largar para texto, imagens e disposição, sem necessidade de código. O que antes era o CMS mais simples do Cocoso é agora um verdadeiro construtor de páginas.\",\"Cada página passa automaticamente a fazer parte da sua navegação. Use-a para uma página Sobre Nós, um conjunto de termos, uma campanha pontual, ou uma secção inteiramente nova do seu site — composta livremente, publicada de imediato.\"],\"adminTitle\":\"Painel de Administração\",\"adminTags\":[\"Configuração da Organização\",\"Identidade Visual\",\"Menu e Navegação\",\"Cabeçalho e Rodapé\",\"Definições\"],\"admin\":[\"Um painel de administração dedicado para configurar a sua organização do zero: nome, logótipo, dados de contacto, e todas as definições que moldam a forma como a sua comunidade se apresenta — sem necessidade de código.\",\"Personalize o seu menu, cabeçalho e rodapé, e decida exatamente o que os visitantes veem primeiro. É a sala de comando por trás de cada comunidade Cocoso, feita para administradores, não para programadores.\"],\"designTitle\":\"Preferências de Design\",\"designTags\":[\"Cores\",\"Raio dos Cantos\",\"Fundos\",\"Aspeto e Sensação\"],\"design\":[\"Dê ao site da sua comunidade uma identidade visual própria: escolha as suas cores, ajuste o raio dos cantos, defina um fundo — torne-o claramente seu, sem tocar numa única linha de CSS.\",\"As preferências de design aplicam-se a todo o seu site de uma só vez, para que a presença da sua comunidade se mantenha coerente à medida que cresce, desde a página inicial ao calendário, passando por cada página compósita.\"],\"newsletterTitle\":\"Newsletter e E-mails\",\"newsletterTags\":[\"Newsletter por E-mail\",\"E-mails Automáticos\",\"Comunicação com Membros\"],\"newsletter\":[\"Chegue diretamente a cada membro com uma newsletter por e-mail — sem necessidade de uma ferramenta de lista de distribuição à parte. Escreva uma vez, envie a toda a sua comunidade, e mantenha as pessoas informadas sem depender de uma rede social.\",\"Os e-mails automáticos tratam dos momentos de rotina por si: confirmações de inscrição, verificações de presença e outras notificações a membros são enviadas sozinhas, para que os administradores se possam concentrar na comunidade em vez da caixa de entrada.\"]},\"clients\":{\"pageTitle\":\"Casos de Utilização\",\"pageLead\":\"Comunidades, estúdios e artistas reais que já usam o Cocoso — redes federadas, espaços de trabalho partilhados, calendários de eventos e portefólios pessoais, cada um adaptado à medida.\",\"samarbetetTitle\":\"Samarbetet\",\"samarbetetTags\":[\"Suécia\",\"Federação\",\"Artistas e Espaços Culturais\"],\"samarbetet\":[\"O Samarbetet é uma federação de comunidades independentes por toda a Suécia — artistas, espaços artísticos, jardins, oficinas e pessoas, ligados numa mesma rede partilhada.\",\"Os seus membros partilham palcos, jardins, oficinas e espaços de encontro, gerem os seus próprios programas e lojas, e mantêm-se independentes ao mesmo tempo que beneficiam de uma porta de entrada partilhada para todo o ecossistema.\"],\"samarbetetLinkLabel\":\"Visitar samarbetet.org\",\"kkvTitle\":\"KKV Estocolmo\",\"kkvTags\":[\"Reserva de Recursos\",\"200+ Recursos\",\"400+ Membros\"],\"kkv\":[\"A KKV Estocolmo — Konstnärernas Kollektivverkstad — é um espaço de trabalho coletivo para artistas profissionais, dando a mais de 400 membros acesso partilhado a mais de 200 equipamentos e espaços de oficina.\",\"Os membros reservam recursos através do calendário do Cocoso, publicam os seus próprios portefólios e eventos públicos, e encontram-se numa página de membros partilhada — uma oficina grande e movimentada gerida sem esforço numa única plataforma.\"],\"kkvLinkLabel\":\"Visitar stockholm.kkv.nu\",\"hojdenTitle\":\"höjden\",\"hojdenTags\":[\"Espaço Autogerido por Artistas\",\"Reserva de Recursos\",\"Portefólios\"],\"hojden\":[\"O höjden é um espaço autogerido por artistas em Estocolmo — estúdios, um palco, uma pista de dança, uma galeria e uma cozinha, geridos coletivamente pela cooperativa Släktet desde 2018.\",\"Tal como a KKV, o höjden usa o Cocoso para gerir as reservas dos seus espaços e equipamentos partilhados, juntamente com portefólios de membros e um programa público de oficinas, espetáculos e palestras.\"],\"hojdenLinkLabel\":\"Visitar hojden.house\",\"gerlesborgTitle\":\"Gerlesborgs Kulturhus\",\"gerlesborgTags\":[\"Centro Cultural\",\"Eventos Públicos\",\"Calendário\"],\"gerlesborg\":[\"O Gerlesborgs kulturhus é um centro cultural em Hamburgsund, na Suécia, que acolhe exposições, concertos, oficinas e um festival literário para a comunidade envolvente.\",\"Usa o Cocoso de forma simples e eficaz para publicar o seu programa público — cada exposição, concerto e curso aparece diretamente no calendário, sem necessidade de uma ferramenta de eventos à parte.\"],\"gerlesborgLinkLabel\":\"Visitar gerlesborgskulturhus.se\",\"minaTitle\":\"Mîna Kocailik\",\"minaTags\":[\"Portefólio\",\"Artista Independente\"],\"mina\":[\"Mîna Kocailik é uma artista independente que usa o Cocoso simplesmente para publicar o seu portefólio: uma apresentação limpa e autogerida do seu trabalho, sem nada extra para manter.\",\"É a utilização mais pequena possível do Cocoso — a prova de que a mesma plataforma que serve federações de centenas de pessoas funciona igualmente bem para uma única prática criativa.\"],\"minaLinkLabel\":\"Visitar o seu portefólio\"},\"credits\":{\"title\":\"Créditos\",\"first\":\"Desenvolvido numa colaboração fantástica com\",\"second\":\"Com o apoio de\"},\"contact\":{\"title\":\"Contacto\",\"heading\":\"Podemos trabalhar juntos\",\"body\":\"Tem um projeto em que o Cocoso possa ser útil? Ou só quer dizer olá e tornar-se nosso amigo? Deixe-nos aqui uma mensagem, e entraremos em contacto consigo!\",\"email\":\"O seu endereço de e-mail\",\"subject\":\"Assunto\",\"message\":\"Mensagem\",\"send\":\"Enviar\"},\"footer\":{\"tagline\":\"Software de código aberto para federações de comunidades, cooperativas e grupos de base — um site público e uma intranet privada, sempre nos seus próprios termos.\",\"exploreTitle\":\"Explorar\",\"projectTitle\":\"Projeto\",\"license\":\"Livre e de código aberto, licenciado sob a GNU GPLv3.\",\"bottom\":\"© {{year}} Cocoso. Criado para comunidades autónomas em todo o lado.\"},\"source\":\"Fonte\"}}},\"__N_SSG\":true},\"page\":\"/contact\",\"query\":{},\"buildId\":\"iiKTSGLeTnVn8oxBX9BaC\",\"isFallback\":false,\"gsp\":true,\"locale\":\"pt-PT\",\"locales\":[\"en\",\"sv\",\"tr\",\"de\",\"es\",\"pt-PT\",\"pt-BR\"],\"defaultLocale\":\"en\",\"scriptLoader\":[]}</script></body></html>","json":{"pageProps":{"__lang":"pt-PT","__namespaces":{"common":{"meta":{"title":"Cocoso — Software de Cooperação Comunitária","description":"Software de código aberto para federações de comunidades, cooperativas e grupos de base — calendário, recursos, eventos, grupos, páginas compósitas e muito mais, sempre nos seus próprios termos."},"brand":{"title":"COCOSO","slogan":"Software de Cooperação Comunitária"},"nav":{"home":"Início","features":"Funcionalidades","examples":"Exemplos","contact":"Contacto","sourceCode":"Código-Fonte","getStarted":"Explorar Funcionalidades","demo":"Demonstração ao Vivo","language":"Idioma"},"home":{"leadTitle":"Software para Comunidades Autónomas e Federadas","lead":["O Cocoso é software de código aberto para comunidades autónomas: um site público e uma intranet, num só lugar. Foi construído para cooperativas, ecoaldeias, espaços autogeridos por artistas, festivais e grupos de base que querem gerir as suas próprias operações, nos seus próprios termos.","Um único início de sessão. Muitas comunidades. Os seus dados, sempre seus."],"leadTags":["Plataformas Online","Cooperativas","Organizações Sem Fins Lucrativos","Festivais","Conferências","Espaços Autogeridos por Artistas","Ecoaldeias","Comunidades","Parques de Campismo"],"tripleTitle":"Mais do que um Site","tripleTags":["Site Público","Rede Comunitária","Ferramenta de Produtividade"],"triple":["O Cocoso é um site público, para que o mundo veja quem são, o que fazem e o que aí vem — sem necessidade de um site à parte.","É também uma rede comunitária privada: os membros podem seguir atividades, partilhar novidades e manter-se em contacto uns com os outros — sem anúncios, algoritmos ou rastreamento. Redes sociais, sem a exploração de dados.","E é uma verdadeira ferramenta de produtividade para o lado prático de gerir uma comunidade: um calendário partilhado, reservas de recursos, confirmações de presença e ferramentas de administração que mantêm todos a par."],"federationTitle":"Federação","federationTags":["Rede Multicomunitária","Portal","Descoberta Partilhada","Autónoma por Definição"],"federation":["O Cocoso não está limitado a um único grupo. Uma única instalação pode alojar toda uma federação de comunidades independentes — cada uma com o seu próprio domínio, a sua própria identidade visual, os seus próprios membros — mantendo-se visível como parte de uma rede mais alargada.","Uma federação pode designar uma comunidade como o seu Portal: uma porta de entrada partilhada onde os visitantes navegam por cada comunidade-membro, filtram atividades em toda a rede e encontram o seu caminho. Cada uma mantém a sua independência; a rede mantém a sua coesão.","É uma solução natural para um movimento composto por muitos grupos autónomos — como uma rede de ecoaldeias, cooperativas ou iniciativas de base que querem manter-se unidas sem abdicar da autogestão local."],"accountsTitle":"Um Início de Sessão, Muitas Comunidades","accountsTags":["Contas Globais","Papéis por Comunidade","Identidade Portátil","Adesão Verificada"],"accounts":["Cada pessoa tem uma única conta Cocoso, onde quer que as suas comunidades estejam. Junte-se a uma cooperativa aqui, a um festival ali, a uma ecoaldeia noutro lugar — uma identidade acompanha-o, enquanto o seu papel e visibilidade são definidos de forma independente em cada local.","Os administradores verificam os membros comunidade a comunidade, concedendo o direito de publicar atividades, gerir um grupo ou administrar recursos localmente — sem nunca precisarem de mexer nas definições ou nos membros de outra comunidade."],"dataTitle":"Os Seus Dados São Seus","dataTags":["Sem Rastreamento","Sem Terceiros","Soberania dos Dados","Privacidade desde a Conceção"],"data":["O Cocoso não tem ferramentas para espiar utilizadores ou rastrear os seus dados. Nenhuma informação é partilhada com serviços de terceiros ou anunciantes — os dados pertencem à comunidade que os criou, ponto final.","Cada membro decide quanto da sua própria informação partilhar, e cada comunidade decide quanto da sua atividade expõe à federação mais alargada. Gere os seus projetos, e os seus dados, nos seus próprios termos."],"openSourceTitle":"Código Aberto","openSourceTags":["Pode ser Autoalojado","Orientado pela Comunidade","Transparente","Livre como em Liberdade"],"openSource":["O Cocoso é software livre e de código aberto, desenvolvido à vista de todos — pode ler todas as linhas de código, correr o software no seu próprio servidor, ou confiar num alojamento à sua escolha. Sem dependência de fornecedor, sem caixa negra.","É moldado pelas comunidades que o utilizam: artistas, cooperativas, projetos de moeda alternativa e espaços de cocriação que têm devolvido necessidades reais ao projeto desde os seus primeiros dias."],"ctaTitle":"Veja Tudo o que o Cocoso Pode Fazer","ctaBody":"Do calendário ao painel de administração, cada funcionalidade foi pensada para ser usada por uma comunidade, não por um webmaster. Explore o que aqui está.","ctaButton":"Explorar Funcionalidades","ctaSecondary":"Ou diga apenas olá"},"features":{"pageTitle":"Funcionalidades","pageLead":"O Cocoso em detalhe — cada ferramenta que a sua comunidade pode usar, e como funciona.","groupCommunityTitle":"Para a Sua Comunidade","groupAdminTitle":"Para Administradores","activityTitle":"Atividades","activityTags":["Eventos Públicos","Confirmação de Presença","Trabalhos em Curso","Espetáculos","Exposições","Concertos","Conferências","Internos","Reservas"],"activities":["A primeira versão do Cocoso foi construída para um teatro de dança autogerido por artistas e um espaço de coaprendizagem, que acolhia várias representações públicas para um público previamente inscrito. Gerir e publicar eventos personalizáveis e recorrentes exige várias funcionalidades distintas, incluindo a confirmação de presença. As inscrições são comunicadas aos convidados por e-mail, e os administradores do evento podem verificar as chegadas à porta.","Pode criar, editar e eliminar conteúdo com uma imagem, título, descrição e informação adicional, além de um conjunto de datas e horários opcionalmente múltiplos — assim, os administradores nunca precisam de criar uma nova entrada para cada ocorrência."],"resourceTitle":"Recursos","resourceTags":["Partilha de Recursos","Gestão de Bens Comuns"],"resources":["O Cocoso permite planear e ter uma visão geral atempada dos processos de partilha de recursos. Sempre que um utilizador verificado reserva um recurso físico ou um espaço, essa informação é partilhada com os membros do coletivo através do calendário.","Não há convites de calendário. Acreditamos que as máquinas devem ajudar-nos a facilitar a nossa própria comunicação e partilha — não agir por nós. O calendário do Cocoso é a face principal dos eventos comunitários e da partilha de recursos, para que continuemos a falar uns com os outros, tal como libertamos os nossos e-mails da confusão de dados."],"calendarTitle":"Calendário","calendarTags":["Agendamento","Agenda","Partilha de Bens Comuns","Programação de Atividades","Reservas de Recursos"],"calendar":["O calendário web do Cocoso pode mostrar eventos e atualizações de recursos mensais, semanais ou diários, e os utilizadores navegam entre estes períodos com um único toque. Cada entrada pode corresponder a uma atividade de utilização de recursos ou a um evento comunitário.","Cada entrada pode ter uma categoria atribuída — um recurso reservado, ou um tipo de atividade como ioga — útil tanto para listagens públicas de atividades como para reservas internas ou privadas. Como qualquer funcionalidade do Cocoso, é intencionalmente abstrata para se adaptar a casos de uso muito diferentes."],"groupTitle":"Grupos","groupTags":["Grupos de Estudo","Escolas","Cocriação","Eventos Recorrentes","Documentos Partilhados","Atividades de Membros"],"groups":["Um Grupo é um conceito, e um conjunto de atividades conceptualmente orientadas, levadas a cabo por um conjunto de pessoas — de forma virtual ou presencial. Num grupo, os membros podem realizar atividades colaborativas com todos os detalhes práticos, informação básica e datas documentados numa única página.","Os grupos permitem gerir formação, atividades sociais ou de aprendizagem — sessões recorrentes de ioga, períodos escolares, ou qualquer tipo de cocriação e processo em evolução contínua. Os administradores criam um grupo com uma imagem e algum texto, e um fórum simples, uma lista de documentos, uma lista de membros e um conjunto de datas ficam prontos numa única página.","É, no fundo, o conjunto de ferramentas para gerir uma escola, uma sessão recorrente, ou uma atividade cooperativa de qualquer tipo."],"workTitle":"Obras","workTags":["Portefólio","Mercado","Documentação","Apresentação"],"works":["Uma Obra é uma criação visual, ou audiovisual, de um artista, investigador, designer, artesão ou revendedor, apresentada à comunidade. Detalhes, imagens, ficheiros de áudio e vídeos podem ser partilhados dentro de uma categoria escolhida pelo criador — uma ferramenta pensada tanto para portefólios como para mercados.","Uma obra também pode ser guardada de forma privada, para uso interno e documentação. Foi pensada para permitir que artistas e artesãos publiquem e comuniquem o que fazem ao resto do mundo, mantendo também um registo para referência própria."],"memberTitle":"Membros","memberTags":["Gerir Membros","Comunidade","Adesões","Verificação","Papéis e Privilégios","Seguidores"],"members":["Os administradores conseguem encontrar, filtrar e gerir todos os membros da organização a partir de um único lugar: verificar ou retirar a verificação de pessoas para capacidades específicas, como publicar atividades no calendário ou criar um grupo.","Se gere um estúdio de ioga, por exemplo, terá tanto professores como alunos na mesma plataforma — verifique os seus professores para que possam criar as suas próprias atividades, enquanto os alunos apenas participam e confirmam presença.","Os privilégios são distribuídos de forma significativa por toda a comunidade, e cada utilizador cria e gere a sua própria conta. As palavras-passe são automaticamente encriptadas, pelo que os administradores do sistema não conseguem lê-las nem rastreá-las."],"pagesTitle":"Páginas Compósitas","pagesTags":["Arrastar e Largar","Páginas de Destino","Campanhas","Páginas Estáticas","Sem Código"],"pages":["Construa livremente uma página de destino, uma página de campanha, ou qualquer página estática de que a sua comunidade precise — com blocos de arrastar e largar para texto, imagens e disposição, sem necessidade de código. O que antes era o CMS mais simples do Cocoso é agora um verdadeiro construtor de páginas.","Cada página passa automaticamente a fazer parte da sua navegação. Use-a para uma página Sobre Nós, um conjunto de termos, uma campanha pontual, ou uma secção inteiramente nova do seu site — composta livremente, publicada de imediato."],"adminTitle":"Painel de Administração","adminTags":["Configuração da Organização","Identidade Visual","Menu e Navegação","Cabeçalho e Rodapé","Definições"],"admin":["Um painel de administração dedicado para configurar a sua organização do zero: nome, logótipo, dados de contacto, e todas as definições que moldam a forma como a sua comunidade se apresenta — sem necessidade de código.","Personalize o seu menu, cabeçalho e rodapé, e decida exatamente o que os visitantes veem primeiro. É a sala de comando por trás de cada comunidade Cocoso, feita para administradores, não para programadores."],"designTitle":"Preferências de Design","designTags":["Cores","Raio dos Cantos","Fundos","Aspeto e Sensação"],"design":["Dê ao site da sua comunidade uma identidade visual própria: escolha as suas cores, ajuste o raio dos cantos, defina um fundo — torne-o claramente seu, sem tocar numa única linha de CSS.","As preferências de design aplicam-se a todo o seu site de uma só vez, para que a presença da sua comunidade se mantenha coerente à medida que cresce, desde a página inicial ao calendário, passando por cada página compósita."],"newsletterTitle":"Newsletter e E-mails","newsletterTags":["Newsletter por E-mail","E-mails Automáticos","Comunicação com Membros"],"newsletter":["Chegue diretamente a cada membro com uma newsletter por e-mail — sem necessidade de uma ferramenta de lista de distribuição à parte. Escreva uma vez, envie a toda a sua comunidade, e mantenha as pessoas informadas sem depender de uma rede social.","Os e-mails automáticos tratam dos momentos de rotina por si: confirmações de inscrição, verificações de presença e outras notificações a membros são enviadas sozinhas, para que os administradores se possam concentrar na comunidade em vez da caixa de entrada."]},"clients":{"pageTitle":"Casos de Utilização","pageLead":"Comunidades, estúdios e artistas reais que já usam o Cocoso — redes federadas, espaços de trabalho partilhados, calendários de eventos e portefólios pessoais, cada um adaptado à medida.","samarbetetTitle":"Samarbetet","samarbetetTags":["Suécia","Federação","Artistas e Espaços Culturais"],"samarbetet":["O Samarbetet é uma federação de comunidades independentes por toda a Suécia — artistas, espaços artísticos, jardins, oficinas e pessoas, ligados numa mesma rede partilhada.","Os seus membros partilham palcos, jardins, oficinas e espaços de encontro, gerem os seus próprios programas e lojas, e mantêm-se independentes ao mesmo tempo que beneficiam de uma porta de entrada partilhada para todo o ecossistema."],"samarbetetLinkLabel":"Visitar samarbetet.org","kkvTitle":"KKV Estocolmo","kkvTags":["Reserva de Recursos","200+ Recursos","400+ Membros"],"kkv":["A KKV Estocolmo — Konstnärernas Kollektivverkstad — é um espaço de trabalho coletivo para artistas profissionais, dando a mais de 400 membros acesso partilhado a mais de 200 equipamentos e espaços de oficina.","Os membros reservam recursos através do calendário do Cocoso, publicam os seus próprios portefólios e eventos públicos, e encontram-se numa página de membros partilhada — uma oficina grande e movimentada gerida sem esforço numa única plataforma."],"kkvLinkLabel":"Visitar stockholm.kkv.nu","hojdenTitle":"höjden","hojdenTags":["Espaço Autogerido por Artistas","Reserva de Recursos","Portefólios"],"hojden":["O höjden é um espaço autogerido por artistas em Estocolmo — estúdios, um palco, uma pista de dança, uma galeria e uma cozinha, geridos coletivamente pela cooperativa Släktet desde 2018.","Tal como a KKV, o höjden usa o Cocoso para gerir as reservas dos seus espaços e equipamentos partilhados, juntamente com portefólios de membros e um programa público de oficinas, espetáculos e palestras."],"hojdenLinkLabel":"Visitar hojden.house","gerlesborgTitle":"Gerlesborgs Kulturhus","gerlesborgTags":["Centro Cultural","Eventos Públicos","Calendário"],"gerlesborg":["O Gerlesborgs kulturhus é um centro cultural em Hamburgsund, na Suécia, que acolhe exposições, concertos, oficinas e um festival literário para a comunidade envolvente.","Usa o Cocoso de forma simples e eficaz para publicar o seu programa público — cada exposição, concerto e curso aparece diretamente no calendário, sem necessidade de uma ferramenta de eventos à parte."],"gerlesborgLinkLabel":"Visitar gerlesborgskulturhus.se","minaTitle":"Mîna Kocailik","minaTags":["Portefólio","Artista Independente"],"mina":["Mîna Kocailik é uma artista independente que usa o Cocoso simplesmente para publicar o seu portefólio: uma apresentação limpa e autogerida do seu trabalho, sem nada extra para manter.","É a utilização mais pequena possível do Cocoso — a prova de que a mesma plataforma que serve federações de centenas de pessoas funciona igualmente bem para uma única prática criativa."],"minaLinkLabel":"Visitar o seu portefólio"},"credits":{"title":"Créditos","first":"Desenvolvido numa colaboração fantástica com","second":"Com o apoio de"},"contact":{"title":"Contacto","heading":"Podemos trabalhar juntos","body":"Tem um projeto em que o Cocoso possa ser útil? Ou só quer dizer olá e tornar-se nosso amigo? Deixe-nos aqui uma mensagem, e entraremos em contacto consigo!","email":"O seu endereço de e-mail","subject":"Assunto","message":"Mensagem","send":"Enviar"},"footer":{"tagline":"Software de código aberto para federações de comunidades, cooperativas e grupos de base — um site público e uma intranet privada, sempre nos seus próprios termos.","exploreTitle":"Explorar","projectTitle":"Projeto","license":"Livre e de código aberto, licenciado sob a GNU GPLv3.","bottom":"© {{year}} Cocoso. Criado para comunidades autónomas em todo o lado."},"source":"Fonte"}}},"__N_SSG":true}}