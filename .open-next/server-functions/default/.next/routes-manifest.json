    },
    {
      "page": "/about",
      "dataRouteRegex": "^/_next/data/Ih6amJPyctjAuesHQ7FZZ/about\\.json$"
    },
    {
      "page": "/clients",
      "dataRouteRegex": "^/_next/data/Ih6amJPyctjAuesHQ7FZZ/clients\\.json$"
    },
    {
      "page": "/contact",
